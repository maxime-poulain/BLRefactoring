<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <!--
        The one project exempt from the solution's warnings-as-errors, and it holds exactly one
        file: two and a half thousand lines of NSwag output that CI regenerates and commits by
        itself (ADR 0008). Its `<auto-generated>` header already stops the analyzers, but not the
        compiler — which is why NSwag emits eighteen `#pragma warning disable` directives of its
        own: fifteen file-wide at the top, and a member-scoped CS8618 disable in three generated
        classes. If a future regeneration produced a warning outside that list, the build would break
        with no commit behind it, and the only remedy would be hand-editing a machine-written file.
        Nothing here is read, reviewed or maintained by a person, so there is nothing for the rules
        to protect. See ADR 0019.
    -->
    <PropertyGroup>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

</Project>
