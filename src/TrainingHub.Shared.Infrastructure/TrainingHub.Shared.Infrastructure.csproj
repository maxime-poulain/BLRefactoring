<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <!--
      No FrameworkReference to Microsoft.AspNetCore.App: this project is about persistence, and
      everything that needed MVC, authentication or authorization moved to
      TrainingHub.Shared.Api. Microsoft.AspNetCore.Identity.EntityFrameworkCore stays — it is
      the store behind TrainingIdentityDbContext, and unlike the JwtBearer package it does not
      drag the ASP.NET Core shared framework in with it.
    -->
    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
      <!--
        The S3 client, for S3ObjectStore. This is the only project that references it, and an
        architecture rule holds that line: the point of IObjectStore is that nothing above the
        infrastructure knows which storage protocol is in use, and a reference reaching one project
        further up would quietly make that untrue. See ADR 0021.
      -->
      <PackageReference Include="AWSSDK.S3" />
      <!--
        The SMTP client, for SmtpEmailSender. Same containment as AWSSDK.S3 above: this is the only
        project that references it, and an architecture rule holds that line — nothing above the
        infrastructure knows which mail protocol is in use. See ADR 0031.
      -->
      <PackageReference Include="MailKit" />
      <!--
        The imaging library, for SkiaSharpPhotoSanitiser. Same containment as the two above, and
        held by the same kind of rule: a portrait is decoded and re-encoded in exactly one place,
        and nothing above the infrastructure knows what decodes it. The native assets are requested
        beside it because a managed reference alone loads nothing at run time on Linux — the first
        decode would throw DllNotFoundException, in the container rather than here. See ADR 0063.
      -->
      <PackageReference Include="SkiaSharp" />
      <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
      <!--
        AddInfrastructure asks IHostEnvironment whether it is running in Development before
        enabling EF Core's sensitive-data logging. That abstraction used to arrive through the
        ASP.NET Core framework reference; now that persistence no longer carries the whole web
        framework, the one piece it genuinely needs is requested on its own.
      -->
      <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    </ItemGroup>

    <!--
      Domain, for the aggregates this project maps and the repository interfaces it implements.
      Application, for the read ports it answers: ITrainingOwnerQuery, ITrainerIdentityQuery and
      ITrainerAccountQuery are declared where the projections live and implemented here, where the
      DbContexts are — the last of the three opens both of them. Infrastructure
      depending on Application is the direction Clean Architecture expects — the same edge
      TrainingHub.DDDWithCqrs.Infrastructure already carries for its query handlers — and it is the
      reason the API layer no longer holds a domain repository to answer a question about one column.
    -->
    <ItemGroup>
      <ProjectReference Include="..\TrainingHub.Shared.Application\TrainingHub.Shared.Application.csproj" />
      <ProjectReference Include="..\TrainingHub.Shared.Domain\TrainingHub.Shared.Domain.csproj" />
    </ItemGroup>

</Project>
