@page "/trainings"
@attribute [Authorize]
@using BLRefactoring.GeneratedClients
@inject ITrainingClient TrainingClient
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">Trainings</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/trainings/create">
            Create Training
        </MudButton>
    </MudStack>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="my-8">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4">Loading trainings...</MudText>
        </MudStack>
    }
    else if (_trainings is null || _trainings.Count == 0)
    {
        <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.School"
                     Style="font-size: 8rem;"
                     Color="Color.Default"
                     Class="mb-4" />
            <MudText Typo="Typo.h5" Color="Color.Default" Class="mb-2">No trainings yet</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                Get started by creating your first training
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/trainings/create">
                Create Training
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            @foreach (var training in _trainings)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="3" Class="h-100">
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Class="mb-2">@training.Title</MudText>
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                @foreach (var topic in training.Topics)
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Primary"
                                             Variant="Variant.Outlined">
                                        @topic
                                    </MudChip>
                                }
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Href="@($"/trainings/edit/{training.Id}")" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           OnClick="@(() => OpenDeleteDialog(training))" />
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<TrainingDto>? _trainings;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTrainings();
        StateHasChanged();
    }

    private async Task LoadTrainings()
    {
        _isLoading = true;
        try
        {
            _trainings = await TrainingClient.GetAllAsync();
        }
        catch (ApiException<List<Error>> ex)
        {
            foreach (var error in ex.Result)
            {
                Snackbar.Add(error.ErrorMessage, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to load trainings: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An unexpected error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenDeleteDialog(TrainingDto training)
    {
        var parameters = new DialogParameters<DeleteTrainingDialog>
        {
            { x => x.TrainingTitle, training.Title }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<DeleteTrainingDialog>("Delete Training", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await DeleteTraining(training.Id);
        }
    }

    private async Task DeleteTraining(Guid trainingId)
    {
        try
        {
            await TrainingClient.DeleteTrainingAsync(trainingId);
            Snackbar.Add("Training deleted successfully!", Severity.Success);
            await LoadTrainings();
        }
        catch (ApiException<List<Error>> ex)
        {
            foreach (var error in ex.Result)
            {
                Snackbar.Add(error.ErrorMessage, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"Failed to delete training: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An unexpected error occurred: {ex.Message}", Severity.Error);
        }
    }
}
