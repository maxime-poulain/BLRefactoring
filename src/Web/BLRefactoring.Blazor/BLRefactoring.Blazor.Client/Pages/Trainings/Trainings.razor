@page "/trainings"
@attribute [Authorize]
@using BLRefactoring.GeneratedClients
@inject ITrainingClient TrainingClient
@inject ITrainerClient TrainerClient
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">Trainings</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/trainings/create">
            Create Training
        </MudButton>
    </MudStack>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="my-8">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4">Loading trainings...</MudText>
        </MudStack>
    }
    else if (_trainings is null || _trainings.Count == 0)
    {
        <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.School"
                     Style="font-size: 8rem;"
                     Color="Color.Default"
                     Class="mb-4" />
            <MudText Typo="Typo.h5" Color="Color.Default" Class="mb-2">No trainings yet</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                Get started by creating your first training
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/trainings/create">
                Create Training
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            @foreach (var training in _trainings)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="3" Class="h-100">
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Class="mb-2">@training.Title</MudText>
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                @foreach (var topic in training.Topics)
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Primary"
                                             Variant="Variant.Outlined">
                                        @topic
                                    </MudChip>
                                }
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions>
                            @* The catalogue is readable by every signed-in trainer, but only its
                               owner may edit or delete it — the API enforces that with
                               TrainingOwnerPolicy. Offering the buttons to everyone meant a
                               confirmation dialog followed by a 403, and a 403 carries no body, so
                               what the user actually read was "The HTTP status code of the response
                               was not expected (403)". *@
                            @if (training.TrainerId == _currentTrainerId)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Href="@($"/trainings/edit/{training.Id}")" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               OnClick="@(() => OpenDeleteDialog(training))" />
                            }
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private const int StatusForbidden = 403;
    private const int StatusNotFound = 404;

    private List<TrainingResponseHttp>? _trainings;
    private bool _isLoading = true;

    /// <summary>
    /// The signed-in trainer, or <c>null</c> when it could not be read.
    /// </summary>
    /// <remarks>
    /// Null hides every Edit and Delete button rather than showing them all: if the identity of the
    /// caller is unknown, the safe reading is that they own nothing. The API refuses either way —
    /// this only decides what is offered.
    /// </remarks>
    private Guid? _currentTrainerId;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentTrainer();
        await LoadTrainings();
        StateHasChanged();
    }

    private async Task LoadCurrentTrainer()
    {
        try
        {
            var response = await TrainerClient.GetCurrentAsync();
            _currentTrainerId = response.Result.Id;
        }
        catch (ApiException)
        {
            // Leave it null. Nothing to tell the user: the page is still fully usable for reading,
            // and the buttons it hides are ones the API would have refused anyway.
            _currentTrainerId = null;
        }
    }

    private async Task LoadTrainings()
    {
        _isLoading = true;
        try
        {
            _trainings = await TrainingClient.GetAllAsync();
        }
        catch (ApiException<ProblemDetails> ex)
        {
            // One RFC 7807 document rather than a bare array of errors: the detail carries the
            // message, and the domain codes travel in the `domainErrors` extension. See ADR 0004.
            Snackbar.Add(ex.Result.Detail ?? ex.Result.Title ?? "The request was rejected.", Severity.Error);
        }
        catch (ApiException ex)
        {
            // ex.Message here is the generator's own sentence — "The HTTP status code of the
            // response was not expected (503)." It belongs in the console, not on screen.
            Console.Error.WriteLine(ex);
            Snackbar.Add("The trainings could not be loaded. Try again in a moment.", Severity.Error);
        }
        catch (Exception ex)
        {
            // Whatever this is, it is ours. A NullReferenceException must not become UI copy.
            Console.Error.WriteLine(ex);
            Snackbar.Add("Something went wrong loading the trainings.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenDeleteDialog(TrainingResponseHttp training)
    {
        var parameters = new DialogParameters<DeleteTrainingDialog>
        {
            { x => x.TrainingTitle, training.Title }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<DeleteTrainingDialog>("Delete Training", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await DeleteTraining(training.Id);
        }
    }

    private async Task DeleteTraining(Guid trainingId)
    {
        try
        {
            await TrainingClient.DeleteTrainingAsync(trainingId);
            Snackbar.Add("Training deleted successfully!", Severity.Success);
            await LoadTrainings();
        }
        catch (ApiException<ProblemDetails> ex) when (ex.StatusCode == StatusNotFound)
        {
            // Someone deleted it between this page being read and the button being pressed.
            // Not an error the user caused, and the list is simply stale.
            Snackbar.Add("That training no longer exists.", Severity.Info);
            await LoadTrainings();
        }
        catch (ApiException<ProblemDetails> ex)
        {
            // One RFC 7807 document rather than a bare array of errors: the detail carries the
            // message, and the domain codes travel in the `domainErrors` extension. See ADR 0004.
            Snackbar.Add(ex.Result.Detail ?? ex.Result.Title ?? "The request was rejected.", Severity.Error);
        }
        catch (ApiException ex) when (ex.StatusCode == StatusForbidden)
        {
            // Still reachable with the button hidden: the catalogue was read at some point in the
            // past, and hiding the button is a courtesy rather than the guard. A 403 carries no
            // body, so there is nothing to read out of it — hence a sentence of our own.
            Snackbar.Add("That training belongs to another trainer.", Severity.Error);
            await LoadTrainings();
        }
        catch (ApiException ex)
        {
            Console.Error.WriteLine(ex);
            Snackbar.Add("The training could not be deleted. Try again in a moment.", Severity.Error);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            Snackbar.Add("Something went wrong deleting the training.", Severity.Error);
        }
    }
}
