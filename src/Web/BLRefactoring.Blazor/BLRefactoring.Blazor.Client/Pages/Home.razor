@page "/"

<PageTitle>BLRefactoring</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudText Typo="Typo.h3" GutterBottom="true">BLRefactoring</MudText>

    <MudText Typo="Typo.subtitle1" Class="mb-8">
        Trainers publish trainings. This front end talks to the REST API that carries the
        domain model behind it.
    </MudText>

    <AuthorizeView>
        <Authorized>
            <MudPaper Elevation="2" Class="pa-6">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    Signed in as @context.User.Identity?.Name
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-4">
                    Browse the catalogue, publish a training, or edit one you own.
                </MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="/trainings"
                           StartIcon="@Icons.Material.Filled.School">
                    Go to trainings
                </MudButton>
            </MudPaper>
        </Authorized>
        <NotAuthorized>
            <MudPaper Elevation="2" Class="pa-6">
                <MudText Typo="Typo.h6" GutterBottom="true">Sign in to continue</MudText>
                <MudText Typo="Typo.body2" Class="mb-4">
                    Everything past this page requires an account: the catalogue is readable by
                    any signed-in trainer, and a training can only be edited by the trainer who
                    published it.
                </MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login">
                        Sign in
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/register">
                        Create an account
                    </MudButton>
                </MudStack>
            </MudPaper>
        </NotAuthorized>
    </AuthorizeView>
</MudContainer>
