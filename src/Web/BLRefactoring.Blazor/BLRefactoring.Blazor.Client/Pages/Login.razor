@page "/login"
@using BLRefactoring.Blazor.Client.Infrastructure
@inject IBffSessionClient SessionClient
@inject BffAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="height: 80vh;">
    <MudPaper Elevation="4" Class="pa-8 w-100">
        <MudStack Spacing="4">
            <MudText Typo="Typo.h4" Align="Align.Center">Login</MudText>

            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudTextField @bind-Value="_username"
                              Label="Username"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Username is required"
                              Immediate="true"
                              Disabled="_isLoading" />

                <MudTextField @bind-Value="_password"
                              Label="Password"
                              Variant="Variant.Outlined"
                              InputType="@_passwordInputType"
                              Required="true"
                              RequiredError="Password is required"
                              Immediate="true"
                              Disabled="_isLoading"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordIcon"
                              OnAdornmentClick="TogglePasswordVisibility"
                              Class="mt-4" />
            </MudForm>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="@(!_isValid || _isLoading)"
                       OnClick="HandleLogin"
                       Class="mt-4">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </MudButton>

            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                Don't have an account?
                <MudLink Href="/register" Typo="Typo.body2">Register here</MudLink>
            </MudText>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    /// <summary>
    /// Where to go once signed in, as <see cref="RedirectToLogin"/> recorded it.
    /// </summary>
    /// <remarks>
    /// Only a path is honoured. The value arrives from the address bar, so anything that could name
    /// another origin — an absolute URL, or the protocol-relative <c>//evil.example</c> that
    /// <c>Uri.IsWellFormedUriString(..., Relative)</c> happily accepts — is discarded in favour of
    /// the catalogue. Redirecting to wherever a query string says is how a sign-in page becomes a
    /// phishing hop.
    /// </remarks>
    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrlParameter { get; set; }

    private string? ReturnUrl =>
        ReturnUrlParameter is not null
        && ReturnUrlParameter.StartsWith('/')
        && !ReturnUrlParameter.StartsWith("//", StringComparison.Ordinal)
            ? ReturnUrlParameter
            : null;

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isLoading;
    private string _username = string.Empty;
    private string _password = string.Empty;
    private bool _passwordVisible;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        _passwordVisible = !_passwordVisible;
        _passwordInputType = _passwordVisible ? InputType.Text : InputType.Password;
        _passwordIcon = _passwordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private async Task HandleLogin()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        _isLoading = true;
        try
        {
            // No token comes back, and that is the point: the BFF holds it and hands this page a
            // cookie it cannot read. Identity is then whatever /bff/user reports. See ADR 0009.
            var signedIn = await SessionClient.LoginAsync(_username, _password);

            if (!signedIn)
            {
                Snackbar.Add("Invalid username or password.", Severity.Error);
                return;
            }

            AuthStateProvider.NotifyAuthenticationChanged();

            Snackbar.Add("Login successful!", Severity.Success);
            NavigationManager.NavigateTo(ReturnUrl ?? "/trainings");
        }
        catch (Exception ex)
        {
            // The detail is ours, not the user's: an exception message is an implementation
            // detail on a sign-in page, and a NullReferenceException rendered as UI copy tells
            // an attacker more than it tells anyone else.
            Console.Error.WriteLine(ex);
            Snackbar.Add("Sign-in is unavailable right now. Try again in a moment.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
