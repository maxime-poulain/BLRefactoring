@page "/Error"
@using System.Diagnostics
@using Microsoft.Extensions.Localization
@using TrainingHub.Translations
@inject IStringLocalizer<CommonResources> L

@* Where UseExceptionHandler sends a request that failed before any component could answer for
   itself, so it renders on the server with no WebAssembly runtime behind it — which is why it
   reads CommonResources directly rather than through the client's localizer.

   It replaced the framework's scaffold in ADR 0091. What went is the Development Mode section:
   three paragraphs explaining ASPNETCORE_ENVIRONMENT to whoever hit an error, addressed to a
   developer and shown to a visitor. What stays is the identifier, which is the one thing here
   worth carrying into a support message — the same value the logs correlate on (ADR 0026). *@

<PageTitle>@L["ErrorPageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="my-16">
    <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center">
        <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Style="font-size: 6rem;" Class="mb-4"/>
        <MudText Typo="Typo.h5" GutterBottom="true">@L["SomethingWentWrong"]</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6">
            @L["SomethingWentWrongBody"]
        </MudText>
        @if (ShowRequestId)
        {
            <MudText Typo="Typo.caption" Class="mb-6">
                @L["RequestIdentifier"] <code>@RequestId</code>
            </MudText>
        }
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Href="/"
                   StartIcon="@Icons.Material.Filled.Storefront">
            @L["BrowseTheCatalog"]
        </MudButton>
    </MudPaper>
</MudContainer>

@code{
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

}
