@using TrainingHub.Blazor.Client.Components
@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject IStringLocalizer<CommonResources> L

<MudThemeProvider Theme="Theme" @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* Ruled rather than floating: the frame stays quiet so the shelf below can speak. *@
    <MudAppBar Elevation="0" Class="th-appbar">
        @* The brand is the way home, as on every site a visitor has ever used. A link rather
           than a MudText: the text told people where they were, and answered nothing when they
           clicked it. *@
        <MudLink Href="/" Typo="Typo.h5" Color="Color.Inherit" Underline="Underline.None" Class="ml-3 th-brand">
            TrainingHub
        </MudLink>
        @* Outside the AuthorizeView below, and that is the point: the catalog is the one screen
           that does not ask who is looking, so its link is there whether or not anybody is signed
           in (ADR 0062). The label is the first localized word of the surface — the living proof
           that a resource travels from the resx to the screen in the resolved language, on the
           prerendered pass and the interactive one alike (ADR 0088). *@
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/catalog" Class="ml-4">
            @L["Catalog"]
        </MudButton>
        <MudSpacer />
        @* One component for the corner: Sign in for a visitor, the identity and its doors for a
           signed-in caller. The row of buttons that used to sit here lives inside it (ADR 0074). *@
        <UserMenu />
        <CultureSelector />
        <MudIconButton Icon="@Icons.Material.Filled.Brightness4"
                       Color="Color.Inherit"
                       aria-label="@L["ToggleTheme"]"
                       OnClick="@ToggleThemeAsync" />
    </MudAppBar>
    <MudMainContent Class="pt-16 px-4">
        @* Above every routed page, because a suspension is not a fact about one screen. It renders
           nothing at all for a trainer in good standing, and nothing for an account that is nobody's
           trainer (ADR 0057). *@
        <AuthorizeView>
            <Authorized>
                <SuspensionBanner />
                @* Beside the suspension for the same reason, in a friendlier voice: it asks for
                   one click, offers the resend, and dies without a reload the moment the address
                   is proven, because the standing source rereads the database (ADR 0090). *@
                <VerificationBanner />
            </Authorized>
        </AuthorizeView>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    // The key the visitor's choice is kept under. Their choice, not their session: a theme is a
    // preference of the person and the device, so it lives in the browser's own storage rather
    // than in anything the server knows — nothing here identifies anybody (ADR 0009 took the
    // credential out of localStorage; a color preference is exactly what belongs in it).
    private const string ThemeKey = "theme";

    // Where the resolved answer is written, on the document element rather than in a variable: the
    // sheet paints from it before any of this code runs, and this code reads it back rather than
    // deciding a second time. One resolver, one truth (ADR 0077).
    private const string ThemeAttribute = "data-theme";

    // The application's own identity, in both modes: a plaster ground by day and a near-black
    // neutral one by night, green for the actions, brass for the quiet seconds. The night ground
    // carries no hue on purpose — a tinted dark theme reads as a color scheme rather than as dark,
    // and the green that survives is the one doing work. The topic shelves' hues live in app.css:
    // they are the shelf's colors, not the theme's.
    private static readonly MudTheme Theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Background = "#F6F5F1",
            Surface = "#FDFCFA",
            AppbarBackground = "#F6F5F1",
            AppbarText = "#1E241F",
            DrawerBackground = "#F6F5F1",
            TextPrimary = "#1E241F",
            TextSecondary = "#5A6157",
            Primary = "#1D4F3A",
            Secondary = "#B08A3E",
            LinesDefault = "#E2DFD7",
            TableLines = "#E2DFD7"
        },
        // Every value here is written a second time, in app.css's :root[data-theme="dark"] block,
        // because that copy is the one that paints a prerendered page before this one exists
        // (ADR 0077). The two are kept identical by a rule rather than by memory.
        PaletteDark = new PaletteDark
        {
            Background = "#0E0F10",
            BackgroundGray = "#141618",
            Surface = "#191B1D",
            AppbarBackground = "#0E0F10",
            AppbarText = "#F2F3F4",
            DrawerBackground = "#0E0F10",
            TextPrimary = "#F2F3F4",
            TextSecondary = "#9BA1A6",
            Primary = "#57A883",
            // Ink, not the white MudBlazor defaults to: white over this green reads at 3.34:1,
            // which a chip's label cannot live with. Dark on light green reads at 6.59:1.
            PrimaryContrastText = "#0E1210",
            Secondary = "#D2AC63",
            SecondaryContrastText = "#141210",
            LinesDefault = "#2A2E31",
            LinesInputs = "#3A4045",
            TableLines = "#2A2E31",
            Divider = "#2A2E31",
            ActionDefault = "rgba(242, 243, 244, 0.54)"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Source Sans 3", "sans-serif"]
            },
            H4 = new H4Typography
            {
                FontFamily = ["Bricolage Grotesque", "sans-serif"],
                FontWeight = "700",
                LetterSpacing = "-0.02em"
            },
            H5 = new H5Typography
            {
                FontFamily = ["Bricolage Grotesque", "sans-serif"],
                FontWeight = "700",
                LetterSpacing = "-0.01em"
            },
            H6 = new H6Typography
            {
                FontFamily = ["Bricolage Grotesque", "sans-serif"],
                FontWeight = "600"
            },
            Caption = new CaptionTypography
            {
                FontFamily = ["IBM Plex Mono", "monospace"]
            },
            Overline = new OverlineTypography
            {
                FontFamily = ["IBM Plex Mono", "monospace"]
            }
        }
    };

    private bool _isDarkMode;

    /// <inheritdoc />
    /// <remarks>
    /// The theme is decided before this component exists, by the script in the document's head:
    /// it reads the stored choice, falls back to the device's preference, and stamps the answer on
    /// the document element, so the first paint is already right on a prerendered page (ADR 0077).
    /// What is left here is to tell C# what the page is already wearing — the toggle has to start
    /// from the true state, and MudBlazor's own variables have to agree with the sheet's.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var painted = await JS.InvokeAsync<string?>("document.documentElement.getAttribute", ThemeAttribute);

        _isDarkMode = string.Equals(painted, "dark", StringComparison.Ordinal);

        StateHasChanged();
    }

    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;

        var chosen = _isDarkMode ? "dark" : "light";

        // Both writes, and neither is optional. The storage is what the next visit reads; the
        // attribute is what this page is painted by, because app.css's dark block outranks the
        // :root variables MudBlazor rewrites at runtime. A toggle that only told C# would leave
        // that block winning, and a visitor who asked for light would stay in the dark.
        await JS.InvokeVoidAsync("localStorage.setItem", ThemeKey, chosen);
        await JS.InvokeVoidAsync("document.documentElement.setAttribute", ThemeAttribute, chosen);
    }
}
