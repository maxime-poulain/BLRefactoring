@page "/catalog/trainers/{TrainerId:guid}"
@using TrainingHub.GeneratedClients
@implements IDisposable
@inject ICatalogClient CatalogClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject PersistentComponentState ApplicationState

@* No [Authorize] either, for the same reason as the pages it is reached from: a person with
   something on offer is part of the catalog, and the catalog answers anybody (ADR 0070). *@

<PageTitle>@(_trainer is null ? "Trainer" : $"{_trainer.Firstname} {_trainer.Lastname}") — TrainingHub</PageTitle>

<HeadContent>
    @* What this page says about itself to the machines that read it (ADR 0073). The full head is
       earned by having a profile to describe; the branches that render a panel instead say
       noindex, for the training page's reason — a panel leaves as HTTP 200, and an index full
       of GUIDs nobody offers serves no one. *@
    <meta name="description" content="@(_trainer is null ? FallbackDescription : Description(_trainer))"/>
    @if (_trainer is not null)
    {
        <link rel="canonical" href="@CanonicalUrl"/>
        <meta property="og:title" content="@($"{_trainer.Firstname} {_trainer.Lastname} — TrainingHub")"/>
        <meta property="og:description" content="@Description(_trainer)"/>
        <meta property="og:type" content="website"/>
        <meta property="og:url" content="@CanonicalUrl"/>
        @if (_trainer.PhotoId is not null)
        {
            @* The crawler's door rather than the API's own portrait route: the /api guard asks
               for headers a link unfurler does not send (ADR 0073). *@
            <meta property="og:image" content="@PortraitDoorUrl(_trainer)"/>
        }
        @CatalogPageHead.JsonLdScript(PersonJsonLd(_trainer))
    }
    else if (!_isLoading)
    {
        <meta name="robots" content="noindex"/>
    }
</HeadContent>

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-4">
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               Href="/catalog"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Class="mb-4 th-back">
        Back to the catalog
    </MudButton>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="my-8">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </MudStack>
    }
    else if (_isUnreachable)
    {
        @* Kept apart from the panel below on purpose: "we could not ask" and "the answer is no"
           are different things to be told, and merging them would make an outage look like a
           person who left. *@
        <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.CloudOff" Style="font-size: 6rem;" Class="mb-4" />
            <MudText Typo="Typo.h6">The catalog could not be reached</MudText>
        </MudPaper>
    }
    else if (_trainer is null)
    {
        @* One panel for every way a profile answers nothing — no such person, suspended, nothing
           published — because the API answers 404 to all of them and a visitor is owed no more
           than that (ADR 0070). *@
        <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size: 6rem;" Class="mb-4" />
            <MudText Typo="Typo.h6" GutterBottom="true">This profile is not available</MudText>
            <MudText Typo="Typo.body2">The trainer may not exist, or may have nothing on offer.</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-6 pl-8 th-sheet">
            @* The person's spine is brass — the identity's own metal, the one the avatar wears —
               where a training's sheet wears the hues of its shelves. *@
            <span class="th-sheet-spine" aria-hidden="true">
                <span style="background-color: var(--mud-palette-secondary)"></span>
            </span>

            @* The face beside the name when there is one to show, addressed by trainer and photo —
               what this page has in hand (ADR 0070). No avatar at all rather than a placeholder: a
               silhouette says "this person has no photo", and the honest reading also covers "they
               have one nobody can prove was stripped" (ADR 0063). *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
                @if (_trainer.PhotoId is not null)
                {
                    <MudAvatar Size="Size.Large">
                        <MudImage Src="@PortraitUrl(_trainer)" Alt="@($"{_trainer.Firstname} {_trainer.Lastname}")" />
                    </MudAvatar>
                }
                <MudText Typo="Typo.h4">@_trainer.Firstname @_trainer.Lastname</MudText>
            </MudStack>

            @if (!string.IsNullOrEmpty(_trainer.Bio))
            {
                <MudText Typo="Typo.h6" Class="th-cue-label" GutterBottom="true">About</MudText>
                <MudText Typo="Typo.body1" Class="mb-6">@_trainer.Bio</MudText>
            }

            <MudText Typo="Typo.h6" Class="th-cue-label" GutterBottom="true">Trainings on offer</MudText>

            @* Never empty: a profile with nothing on offer is a profile the API answered 404 for,
               so this shelf always holds at least one row. Rows of the shelf's own shape, leading
               where a shelf row leads — neutral spines, because a profile row does not say which
               shelf it came from, and a color would be a guess (ADR 0062). *@
            <ul class="th-shelf mt-2">
                @foreach (var (training, index) in _trainer.Trainings.Select((item, i) => (item, i)))
                {
                    <li>
                        <a class="th-row" style="--th-i: @index" href="@($"/catalog/{training.Id}")">
                            <span class="th-spine" style="background-color: var(--th-spine-neutral)"></span>
                            <span class="th-row-title">@training.Title</span>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight"
                                     Size="Size.Small"
                                     Class="th-row-cue" />
                        </a>
                    </li>
                }
            </ul>
        </MudPaper>
    }
</MudContainer>

@code {
    private const int StatusNotFound = 404;

    /// <summary>The trainer the route names.</summary>
    [Parameter]
    public Guid TrainerId { get; set; }

    // The key this page's prerendered answer travels under, from the server's pass to the
    // WebAssembly one (ADR 0072).
    private const string PersistenceKey = "catalog-trainer";

    private CatalogTrainerHttpResponse? _trainer;
    private bool _isLoading = true;
    private bool _isUnreachable;
    private PersistingComponentStateSubscription _persisting;

    /// <inheritdoc />
    protected override void OnInitialized() =>
        _persisting = ApplicationState.RegisterOnPersisting(Persist);

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        // The prerendered pass already asked; taking its answer is what keeps the first paint
        // from being replaced by a spinner and the API from being asked twice (ADR 0072). A 404
        // travels too — the panel it renders is as much the page as a profile is.
        if (ApplicationState.TryTakeFromJson<CatalogTrainerHttpResponse?>(
                PersistenceKey, out var prerendered))
        {
            _trainer = prerendered;
            _isLoading = false;
            return;
        }

        _isLoading = true;
        _isUnreachable = false;
        try
        {
            _trainer = await CatalogClient.GetTrainerProfileAsync(TrainerId);
        }
        catch (ApiException exception) when (exception.StatusCode == StatusNotFound)
        {
            // Not an error to report: a URL somebody kept is allowed to stop working, and the panel
            // above says so in the visitor's terms rather than the transport's.
            _trainer = null;
        }
        catch (Exception)
        {
            // The message is ours rather than the server's: what an exception carries is for a log,
            // and a visitor learns nothing from a stack of it.
            _trainer = null;
            _isUnreachable = true;
            Snackbar.Add("The profile could not be loaded.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// The address of the portrait, built from the trainer and the photo the response named.
    /// </summary>
    /// <remarks>
    /// No cache buster, for the training page's reason: this address carries the photo's identity,
    /// so it stops resolving when the picture is replaced rather than serving a stale one. That is
    /// what lets the endpoint answer <c>immutable</c> honestly (ADR 0063, ADR 0070).
    /// </remarks>
    private static string PortraitUrl(CatalogTrainerHttpResponse trainer) =>
        $"api/Catalog/trainers/{trainer.Id}/photo/{trainer.PhotoId}";

    // What the not-yet-loaded and not-available renders say — nothing about a person nobody can see.
    private const string FallbackDescription = "A trainer with trainings on offer in the TrainingHub catalog.";

    // The bio when there is one, and an honest count when there is not. The count is never zero:
    // a profile with nothing on offer is a profile the API answered 404 for.
    private static string Description(CatalogTrainerHttpResponse trainer) =>
        CatalogPageHead.Summarize(
            trainer.Bio,
            $"{trainer.Trainings.Count} training{(trainer.Trainings.Count == 1 ? "" : "s")} offered by {trainer.Firstname} {trainer.Lastname}.");

    // The address this page answers for: the bare route, whatever address it was reached by.
    private string CanonicalUrl =>
        Navigation.ToAbsoluteUri($"/catalog/trainers/{TrainerId}").ToString();

    // Absolute because Open Graph consumers resolve nothing: they fetch the address as written.
    private string PortraitDoorUrl(CatalogTrainerHttpResponse trainer) =>
        Navigation.ToAbsoluteUri($"/portraits/trainers/{trainer.Id}/{trainer.PhotoId}").ToString();

    // The honest subset of schema.org's Person: what this page actually knows about them.
    private Dictionary<string, object?> PersonJsonLd(CatalogTrainerHttpResponse trainer) => new()
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Person",
        ["name"] = $"{trainer.Firstname} {trainer.Lastname}",
        ["description"] = Description(trainer),
        ["url"] = CanonicalUrl
    };

    private Task Persist()
    {
        // An unreachable API is not an answer to hand over: the interactive pass should ask
        // again rather than inherit a snackbar it never showed.
        if (!_isUnreachable)
        {
            ApplicationState.PersistAsJson(PersistenceKey, _trainer);
        }

        return Task.CompletedTask;
    }

    /// <inheritdoc />
    public void Dispose() => _persisting.Dispose();
}
