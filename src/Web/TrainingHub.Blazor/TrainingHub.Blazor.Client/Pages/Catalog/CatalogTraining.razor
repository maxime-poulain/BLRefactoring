@page "/catalog/{TrainingId:guid}"
@using TrainingHub.GeneratedClients
@inject ICatalogClient CatalogClient
@inject ISnackbar Snackbar

@* No [Authorize] either, for the same reason as the listing it is reached from (ADR 0062). *@

<PageTitle>@(_training?.Title ?? "Training") — TrainingHub</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-4">
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               Href="/catalog"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Class="mb-4">
        Back to the catalog
    </MudButton>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="my-8">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </MudStack>
    }
    else if (_isUnreachable)
    {
        @* Kept apart from the panel below on purpose: "we could not ask" and "the answer is no"
           are different things to be told, and merging them would make an outage look like a
           withdrawn training. *@
        <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.CloudOff" Style="font-size: 6rem;" Class="mb-4" />
            <MudText Typo="Typo.h6">The catalog could not be reached</MudText>
        </MudPaper>
    }
    else if (_training is null)
    {
        @* One panel for "no such training" and for "no longer on offer", because the API answers
           404 to both and a visitor is owed no more than that. Telling them a training exists but
           has been taken down is the administration's read (ADR 0055). *@
        <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size: 6rem;" Class="mb-4" />
            <MudText Typo="Typo.h6" GutterBottom="true">This training is not on offer</MudText>
            <MudText Typo="Typo.body2">It may never have existed, or it may have been withdrawn.</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-6">
            <MudText Typo="Typo.h4" GutterBottom="true">@_training.Title</MudText>

            @* The name, and it is the whole reason this endpoint reads the write model rather than
               the index: no integration event carries a rename, so a stored copy would show whoever
               this trainer used to be. It links to the author's own page, which is where a visitor
               deciding whether to learn from this person goes next (ADR 0070). *@
            @* The face beside it when there is one to show. The address is built from the training
               and the photo — what this page has in hand (ADR 0063). No avatar at all rather than a
               placeholder: a silhouette says "this person has no photo", and the honest reading
               also covers "they have one nobody can prove was stripped". *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
                @if (_training.TrainerPhotoId is not null)
                {
                    <MudAvatar Size="Size.Large">
                        <MudImage Src="@PortraitUrl(_training)" Alt="@_training.TrainerName" />
                    </MudAvatar>
                }
                <MudText Typo="Typo.subtitle1">
                    Offered by
                    <MudLink Href="@($"/catalog/trainers/{_training.TrainerId}")"
                             Typo="Typo.subtitle1">
                        @_training.TrainerName
                    </MudLink>
                </MudText>
            </MudStack>

            @if (_training.Topics.Count > 0)
            {
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-6">
                    @foreach (var topic in _training.Topics)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@topic</MudChip>
                    }
                </MudStack>
            }

            <MudText Typo="Typo.h6" GutterBottom="true">About</MudText>
            <MudText Typo="Typo.body1" Class="mb-6">@_training.Description</MudText>

            <MudText Typo="Typo.h6" GutterBottom="true">Prerequisites</MudText>
            <MudText Typo="Typo.body1" Class="mb-6">@_training.Prerequisites</MudText>

            <MudText Typo="Typo.h6" GutterBottom="true">What you leave with</MudText>
            <MudText Typo="Typo.body1">@_training.AcquiredSkills</MudText>
        </MudPaper>
    }
</MudContainer>

@code {
    private const int StatusNotFound = 404;

    /// <summary>The training the route names.</summary>
    [Parameter]
    public Guid TrainingId { get; set; }

    private CatalogTrainingDetailHttpResponse? _training;
    private bool _isLoading = true;
    private bool _isUnreachable;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _isUnreachable = false;
        try
        {
            _training = await CatalogClient.GetOfferedTrainingAsync(TrainingId);
        }
        catch (ApiException exception) when (exception.StatusCode == StatusNotFound)
        {
            // Not an error to report: a URL somebody kept is allowed to stop working, and the panel
            // above says so in the visitor's terms rather than the transport's.
            _training = null;
        }
        catch (Exception)
        {
            // The message is ours rather than the server's: what an exception carries is for a log,
            // and a visitor learns nothing from a stack of it.
            _training = null;
            _isUnreachable = true;
            Snackbar.Add("The training could not be loaded.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// The address of the portrait, built from the training and the photo the response named.
    /// </summary>
    /// <remarks>
    /// No cache buster, unlike the profile's own portrait: this address carries the photo's
    /// identity, so it stops resolving when the picture is replaced rather than serving a stale one.
    /// That is what lets the endpoint answer <c>immutable</c> honestly (ADR 0063).
    /// </remarks>
    private static string PortraitUrl(CatalogTrainingDetailHttpResponse training) =>
        $"api/Catalog/trainings/{training.Id}/photo/{training.TrainerPhotoId}";
}
