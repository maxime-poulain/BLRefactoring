@page "/catalog/{TrainingId:guid}"
@using TrainingHub.Blazor.Client.Infrastructure
@using TrainingHub.GeneratedClients
@implements IDisposable
@inject ICatalogClient CatalogClient
@inject IDialogService DialogService
@inject TurnstileTokenAccessor TurnstileTokens
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject PersistentComponentState ApplicationState
@inject IStringLocalizer<CatalogResources> L
@inject IStringLocalizer<CommonResources> Common

@* No [Authorize] either, for the same reason as the listing it is reached from (ADR 0062). *@

<PageTitle>@(_training?.Title ?? L["TrainingFallbackTitle"]) — TrainingHub</PageTitle>

<HeadContent>
    @* What this page says about itself to the machines that read it (ADR 0073). The full head is
       earned by having a training to describe; the branches that render a panel instead say
       noindex, because a withdrawn or mistyped identifier still answers HTTP 200 — the router is
       a client component with no status to set — and without the tag every GUID would be an
       indexable page. *@
    <meta name="description" content="@Description"/>
    @if (_training is not null)
    {
        <link rel="canonical" href="@CanonicalUrl"/>
        <meta property="og:title" content="@_training.Title"/>
        <meta property="og:description" content="@Description"/>
        <meta property="og:type" content="website"/>
        <meta property="og:url" content="@CanonicalUrl"/>
        @if (_training.TrainerPhotoId is not null)
        {
            @* The crawler's door rather than the API's own portrait route: the /api guard asks
               for headers a link unfurler does not send (ADR 0073). *@
            <meta property="og:image" content="@PortraitDoorUrl(_training)"/>
        }
        @CatalogPageHead.JsonLdScript(CourseJsonLd(_training))
    }
    else if (!_isLoading)
    {
        <meta name="robots" content="noindex"/>
    }
</HeadContent>

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-4">
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               Href="/catalog"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Class="mb-4 th-back">
        @L["BackToTheCatalog"]
    </MudButton>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="my-8">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </MudStack>
    }
    else if (_isUnreachable)
    {
        @* Kept apart from the panel below on purpose: "we could not ask" and "the answer is no"
           are different things to be told, and merging them would make an outage look like a
           withdrawn training. *@
        <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.CloudOff" Style="font-size: 6rem;" Class="mb-4" />
            <MudText Typo="Typo.h6">@L["CatalogUnreachable"]</MudText>
        </MudPaper>
    }
    else if (_training is null)
    {
        @* One panel for "no such training" and for "no longer on offer", because the API answers
           404 to both and a visitor is owed no more than that. Telling them a training exists but
           has been taken down is the administration's read (ADR 0055). *@
        <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size: 6rem;" Class="mb-4" />
            <MudText Typo="Typo.h6" GutterBottom="true">@L["TrainingNotOnOffer"]</MudText>
            <MudText Typo="Typo.body2">@L["TrainingNotOnOfferBody"]</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-6 pl-8 th-sheet">
            @* The sheet's spine, segmented: one band per topic, each in its shelf's hue, because
               this training sits on every shelf its topics name (ADR 0069). The band's container
               stays neutral, so a training naming no topic still reads as a book. *@
            <span class="th-sheet-spine" aria-hidden="true">
                @foreach (var topic in _training.Topics)
                {
                    <span style="background-color: @CatalogTopics.SpineVar(topic)"></span>
                }
            </span>

            <MudText Typo="Typo.h4" GutterBottom="true">@_training.Title</MudText>

            @* The name, and it is the whole reason this endpoint reads the write model rather than
               the index: no integration event carries a rename, so a stored copy would show whoever
               this trainer used to be. It links to the author's own page, which is where a visitor
               deciding whether to learn from this person goes next (ADR 0070). *@
            @* The face beside it when there is one to show. The address is built from the training
               and the photo — what this page has in hand (ADR 0063). No avatar at all rather than a
               placeholder: a silhouette says "this person has no photo", and the honest reading
               also covers "they have one nobody can prove was stripped". *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
                @if (_training.TrainerPhotoId is not null)
                {
                    <MudAvatar Size="Size.Large">
                        <MudImage Src="@PortraitUrl(_training)" Alt="@_training.TrainerName" />
                    </MudAvatar>
                }
                <MudText Typo="Typo.subtitle1">
                    @L["OfferedBy"]
                    <MudLink Href="@($"/catalog/trainers/{_training.TrainerId}")"
                             Typo="Typo.subtitle1">
                        @_training.TrainerName
                    </MudLink>
                </MudText>
                <MudSpacer />
                @* The same channel the profile offers, from the page a visitor is actually on when
                   a training convinces them (ADR 0082). Asleep until the interactive runtime
                   attaches, for the profile's reason (ADR 0072). *@
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.MailOutline"
                           Disabled="@(!_isInteractive)"
                           OnClick="ContactAsync"
                           Class="th-contact">
                    @L["ContactName", _training.TrainerName]
                </MudButton>
            </MudStack>

            @if (_training.Topics.Count > 0)
            {
                @* The catalog's own chips, marks included, and each one leads back to its shelf:
                   a topic on a sheet is the address of every other training on it (ADR 0069). *@
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-6 th-tags">
                    @foreach (var topic in _training.Topics)
                    {
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined"
                                 Href="@($"/catalog?topic={Uri.EscapeDataString(topic)}")">
                            <span class="th-mark" style="background-color: @CatalogTopics.SpineVar(topic)"></span>
                            @topic
                        </MudChip>
                    }
                </MudStack>
            }

            <MudText Typo="Typo.h6" Class="th-cue-label" GutterBottom="true">@L["About"]</MudText>
            <MudText Typo="Typo.body1" Class="mb-6">@_training.Description</MudText>

            <MudText Typo="Typo.h6" Class="th-cue-label" GutterBottom="true">@L["Prerequisites"]</MudText>
            <MudText Typo="Typo.body1" Class="mb-6">@_training.Prerequisites</MudText>

            <MudText Typo="Typo.h6" Class="th-cue-label" GutterBottom="true">@L["WhatYouLeaveWith"]</MudText>
            <MudText Typo="Typo.body1">@_training.AcquiredSkills</MudText>
        </MudPaper>
    }
</MudContainer>

@code {
    private const int StatusBadRequest = 400;
    private const int StatusForbidden = 403;
    private const int StatusNotFound = 404;
    private const int StatusTooManyRequests = 429;

    /// <summary>The training the route names.</summary>
    [Parameter]
    public Guid TrainingId { get; set; }

    // The key this page's prerendered answer travels under, from the server's pass to the
    // WebAssembly one (ADR 0072).
    private const string PersistenceKey = "catalog-training";

    private CatalogTrainingDetailHttpResponse? _training;
    private bool _isLoading = true;
    private bool _isUnreachable;
    private bool _isInteractive;
    private PersistingComponentStateSubscription _persisting;

    /// <inheritdoc />
    protected override void OnInitialized() =>
        _persisting = ApplicationState.RegisterOnPersisting(Persist);

    /// <inheritdoc />
    /// <remarks>
    /// This never runs during the prerendered pass, and that absence is the mechanism: the contact
    /// button wakes here, so the static paint offers it visibly disabled rather than pretending a
    /// dialog could open where no runtime is attached (ADR 0072, ADR 0082).
    /// </remarks>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _isInteractive = true;
            StateHasChanged();
        }
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        // The prerendered pass already asked; taking its answer is what keeps the first paint
        // from being replaced by a spinner and the API from being asked twice (ADR 0072). A 404
        // travels too — the panel it renders is as much the page as a training is.
        if (ApplicationState.TryTakeFromJson<CatalogTrainingDetailHttpResponse?>(
                PersistenceKey, out var prerendered))
        {
            _training = prerendered;
            _isLoading = false;
            return;
        }

        _isLoading = true;
        _isUnreachable = false;
        try
        {
            _training = await CatalogClient.GetOfferedTrainingAsync(TrainingId);
        }
        catch (ApiException exception) when (exception.StatusCode == StatusNotFound)
        {
            // Not an error to report: a URL somebody kept is allowed to stop working, and the panel
            // above says so in the visitor's terms rather than the transport's.
            _training = null;
        }
        catch (ApiException<ProblemDetails> exception)
        {
            // The declared 400: the address carried an identifier the contract refuses — an empty
            // guid, typically — and the document names the refusal (ADR 0004).
            _training = null;
            _isUnreachable = true;

            foreach (var message in ProblemDetailsMessages.Read(exception.Result, Common["RequestRejected"]))
            {
                Snackbar.Add(message, Severity.Error);
            }
        }
        catch (ApiException exception)
        {
            // ApiException.Message is the generator's own sentence and the raw body with it; it
            // belongs in the console, not on screen.
            Console.Error.WriteLine(exception);
            _training = null;
            _isUnreachable = true;
            Snackbar.Add(L["TrainingLoadFailedRetry"], Severity.Error);
        }
        catch (Exception exception)
        {
            // Whatever this is, it is ours; a visitor learns nothing from a stack of it.
            Console.Error.WriteLine(exception);
            _training = null;
            _isUnreachable = true;
            Snackbar.Add(L["TrainingLoadFailed"], Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// The address of the portrait, built from the training and the photo the response named.
    /// </summary>
    /// <remarks>
    /// No cache buster, unlike the profile's own portrait: this address carries the photo's
    /// identity, so it stops resolving when the picture is replaced rather than serving a stale one.
    /// That is what lets the endpoint answer <c>immutable</c> honestly (ADR 0063).
    /// </remarks>
    private static string PortraitUrl(CatalogTrainingDetailHttpResponse training) =>
        $"api/Catalog/trainings/{training.Id}/photo/{training.TrainerPhotoId}";

    // What a search result quotes under the title. The fallback is what the not-yet-loaded and
    // not-found renders say — nothing about a training nobody can see.
    private string FallbackDescription => L["TrainingMetaFallback"];

    private string Description =>
        CatalogPageHead.Summarize(_training?.Description, FallbackDescription);

    // The address this page answers for: the bare route, whatever address it was reached by.
    private string CanonicalUrl =>
        Navigation.ToAbsoluteUri($"/catalog/{TrainingId}").ToString();

    // Absolute because Open Graph consumers resolve nothing: they fetch the address as written.
    private string PortraitDoorUrl(CatalogTrainingDetailHttpResponse training) =>
        Navigation.ToAbsoluteUri(
            $"/portraits/trainings/{training.Id}/{training.TrainerPhotoId}").ToString();

    // The honest subset of schema.org's Course: name, description and provider are what this page
    // actually knows. No offers and no price, because the domain has neither (ADR 0073). The
    // provider is the platform rather than the person — the vocabulary wants an organization
    // there, and the trainer is described on their own page.
    private Dictionary<string, object?> CourseJsonLd(CatalogTrainingDetailHttpResponse training) => new()
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Course",
        ["name"] = training.Title,
        ["description"] = CatalogPageHead.Summarize(training.Description, FallbackDescription),
        ["url"] = CanonicalUrl,
        ["provider"] = new Dictionary<string, object?>
        {
            ["@type"] = "Organization",
            ["name"] = "TrainingHub"
        }
    };

    /// <summary>
    /// Opens the contact dialog and carries what the visitor wrote to the API.
    /// </summary>
    /// <remarks>
    /// The training travels with the message, and it only names what prompted it: the recipient is
    /// the trainer the route's training belongs to, decided by the API from the address alone —
    /// this page never learns, and never sends, where the message ends up (ADR 0082).
    /// </remarks>
    private async Task ContactAsync()
    {
        if (_training is null)
        {
            return;
        }

        var draft = await ContactTrainerDialogs.AskAsync(
            DialogService, _training.TrainerName, L["ContactName", _training.TrainerName]);

        if (draft is null)
        {
            return;
        }

        try
        {
            // The token rides a header the next request picks up, not the body: the deposit is
            // what keeps the generated client's signature — and the API's contract — free of the
            // BFF's own toll (ADR 0083).
            TurnstileTokens.Deposit(draft.TurnstileToken);

            await CatalogClient.ContactTrainerAsync(_training.TrainerId, new ContactTrainerHttpRequest
            {
                SenderFirstname = draft.Firstname,
                SenderLastname = draft.Lastname,
                SenderEmailAddress = draft.EmailAddress,
                Message = draft.Message,
                TrainingId = TrainingId,
                Website = draft.Website
            });

            Snackbar.Add(L["MessageOnItsWay", _training.TrainerName], Severity.Success);
        }
        catch (ApiException<ProblemDetails> exception) when (exception.StatusCode == StatusBadRequest)
        {
            foreach (var message in ProblemDetailsMessages.Read(exception.Result, L["MessageNotAccepted"]))
            {
                Snackbar.Add(message, Severity.Error);
            }
        }
        catch (ApiException exception) when (exception.StatusCode == StatusForbidden)
        {
            // The BFF's refusal, not the API's: the anti-robot token did not hold up — expired
            // between solving and sending, most likely — and a fresh dialog mints a fresh one.
            Snackbar.Add(L["AntiRobotFailed"], Severity.Warning);
        }
        catch (ApiException exception) when (exception.StatusCode == StatusTooManyRequests)
        {
            // The window is the trainer's, not the visitor's: what ran out is how much mail one
            // person can be made to receive (ADR 0082), so waiting is the honest advice.
            Snackbar.Add(L["TrainerBusy", _training.TrainerName], Severity.Warning);
        }
        catch (ApiException exception) when (exception.StatusCode == StatusNotFound)
        {
            Snackbar.Add(L["TrainerNoLongerContactable"], Severity.Error);
        }
        catch (Exception)
        {
            // The message is ours rather than the server's, for the reason the loads above give.
            Snackbar.Add(L["MessageSendFailed"], Severity.Error);
        }
    }

    private Task Persist()
    {
        // An unreachable API is not an answer to hand over: the interactive pass should ask
        // again rather than inherit a snackbar it never showed.
        if (!_isUnreachable)
        {
            ApplicationState.PersistAsJson(PersistenceKey, _training);
        }

        return Task.CompletedTask;
    }

    /// <inheritdoc />
    public void Dispose() => _persisting.Dispose();
}
