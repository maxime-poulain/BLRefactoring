@page "/"
@page "/catalog"
@using TrainingHub.Blazor.Client.Infrastructure
@using TrainingHub.GeneratedClients
@implements IDisposable
@inject ICatalogClient CatalogClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject PersistentComponentState ApplicationState
@inject IStringLocalizer<CatalogResources> L
@inject IStringLocalizer<CommonResources> Common

@* No [Authorize], and it is the only routed page here without one. ADR 0059 built the index and
   gave it an anonymous endpoint; ADR 0062 gave the endpoint a face and taught the proxy to forward
   this one family of paths without a token. A visitor arrives with no session and stays that way. *@

<PageTitle>@L["CatalogPageTitle"]</PageTitle>

<HeadContent>
    @* What this page says about itself to the machines that read it — search engines and the
       unfurlers behind a shared link (ADR 0073). The canonical names the question, not the view:
       it keeps the topic, a closed set of shelves, and drops the term, the sort and the page —
       a free-text search is not an address to index, and every view of one canonicalizes to its
       shelf. Built from the page's own parameters rather than the raw address, so a tracking
       parameter a visitor arrived with cannot ride into it. *@
    <meta name="description" content="@CatalogDescription"/>
    <link rel="canonical" href="@CanonicalUrl"/>
    <meta property="og:title" content="@L["CatalogPageTitle"]"/>
    <meta property="og:description" content="@CatalogDescription"/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="@CanonicalUrl"/>
</HeadContent>

<MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
    <MudText Typo="Typo.h4" Class="mb-2">@L["TrainingsOnOffer"]</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">
        @L["CatalogIntro"]
    </MudText>

    <MudPaper Elevation="0" Class="pa-4 mb-4">
        @* Two criteria now, and both are the index's own questions: every word of the term is
           matched against the words of a title, each by prefix (ADR 0059), and a topic narrows
           the search to one shelf (ADR 0069). *@
        <MudTextField T="string"
                      Class="th-hero-search"
                      Label="@L["SearchTheShelf"]"
                      Value="@_term"
                      ValueChanged="OnTermChangedAsync"
                      DebounceInterval="400"
                      Variant="Variant.Outlined"
                      Clearable="true"
                      MaxLength="TermMaxLength"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      HelperText="@L["SearchHelper"]" />

        @* The catalog's facets, from GET /Catalog/topics: only topics with something on offer,
           each with its count under the term being searched, so a chip never leads to an empty
           shelf (ADR 0080). Several may be lit at once and they widen rather than narrow — a
           training answers as soon as it sits on one of them. Clicking a lit chip lifts that one
           alone; the whole selection comes off with the last chip in the row. *@
        @if (_facets is { Count: > 0 })
        {
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-3 th-facets">
                @foreach (var facet in _facets)
                {
                    var topic = facet.Topic;
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(_topics.Contains(topic) ? Color.Primary : Color.Default)"
                             Variant="@(_topics.Contains(topic) ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => OnTopicClickedAsync(topic))">
                        @* The shelf's mark: the same hue this topic's spines wear below, so the
                           chip and the rows it filters read as one thing. *@
                        <span class="th-mark" style="background-color: @CatalogTopics.SpineVar(topic)"></span>
                        @topic (@facet.OfferedCount)
                    </MudChip>
                }

                @* One gesture back to the whole catalog. It only exists while there is something
                   to clear, because a permanently lit escape from a state nobody is in reads as a
                   filter of its own. Undoing a selection chip by chip was free when there was only
                   ever one lit; with several it is one click per shelf. *@
                @if (_topics.Count > 0)
                {
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="Color.Default"
                             Variant="Variant.Text"
                             Icon="@Icons.Material.Filled.Close"
                             OnClick="@(() => OnTopicsClearedAsync())">
                        @L["ClearTopics"]
                    </MudChip>
                }
            </MudStack>
        }

        @* The catalog's two published orders (ADR 0071): newest first — the training's own age,
           and the default since the catalog became the front door (ADR 0074) — and by title, for
           whoever wants to scan the shelf. A closed pair of chips rather than a sortable table
           header, because the order is a named question the server answers — not a column to
           click. *@
        <MudStack Row="true" Spacing="1" Class="mt-3">
            <MudChip T="string"
                     Size="Size.Small"
                     Color="@(_newestFirst ? Color.Primary : Color.Default)"
                     Variant="@(_newestFirst ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => OnOrderChangedAsync(newestFirst: true))">
                @L["Newest"]
            </MudChip>
            <MudChip T="string"
                     Size="Size.Small"
                     Color="@(_newestFirst ? Color.Default : Color.Primary)"
                     Variant="@(_newestFirst ? Variant.Outlined : Variant.Filled)"
                     OnClick="@(() => OnOrderChangedAsync(newestFirst: false))">
                @L["AToZ"]
            </MudChip>
        </MudStack>
    </MudPaper>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="my-8">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </MudStack>
    }
    else if (_page is null || _page.Items.Count == 0)
    {
        <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size: 6rem;" Class="mb-4" />
            <MudText Typo="Typo.h6">@L["NoTrainingMatches"]</MudText>
        </MudPaper>
    }
    else
    {
        @* The shelf itself: each training is a spine — one thick edge carrying the shelf being
           browsed, a title, a quiet cue. The whole row is the link, because a title is all a
           search result holds and everything else is on the other side of it (ADR 0062). The
           spine wears the browsed topic's hue, and the neutral tone when no shelf is chosen —
           a search row does not carry its topics, and a color would be a guess. *@
        <ul class="th-shelf">
            @foreach (var (training, index) in _page.Items.Select((item, i) => (item, i)))
            {
                <li>
                    <a class="th-row" style="--th-i: @index" href="@($"/catalog/{training.Id}")">
                        <span class="th-spine" style="background-color: @SpineColor"></span>
                        <span class="th-row-title">@training.Title</span>
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight"
                                 Size="Size.Small"
                                 Class="th-row-cue" />
                    </a>
                </li>
            }
        </ul>

        @if (_page.TotalPages > 1)
        {
            <MudStack AlignItems="AlignItems.Center" Class="mt-6">
                <MudPagination Count="@_page.TotalPages"
                               Selected="@_currentPage"
                               SelectedChanged="OnPageSelectedAsync" />
            </MudStack>
        }
    }
</MudContainer>

@code {
    // The bound the contract publishes. Typing past it would be answered 400 by the server, so the
    // field refuses it here instead — the same reading the administrative screens give.
    private const int TermMaxLength = 100;

    // One sentence for the description meta tag: what a search result quotes under the title.
    private string CatalogDescription => L["CatalogMetaDescription"];

    // The hue the shelf's spines wear: the browsed topic's own, or the neutral tone when no
    // shelf is chosen — a search row carries no topics, and a color would be a guess.
    private string SpineColor =>
        _topics.Count == 1 ? CatalogTopics.SpineVar(_topics[0]) : "var(--th-spine-neutral)";

    // The address this page answers for, whatever address it was reached by.
    private string CanonicalUrl =>
        Navigation.GetUriWithQueryParameters(
            Navigation.ToAbsoluteUri("/catalog").ToString(),
            new Dictionary<string, object?> { ["topic"] = Shelves });

    // The keys the prerendered answers travel under, from the server's pass to the WebAssembly
    // one (ADR 0072). Whatever question the address asked is the question whose answer travels:
    // both passes serve the same request, so they read the same parameters.
    private const string PageKey = "catalog-page";
    private const string FacetsKey = "catalog-facets";

    private PagedHttpResponseOfCatalogTrainingHttpResponse? _page;
    private List<CatalogTopicHttpResponse>? _facets;
    private string? _term;
    private IReadOnlyList<string> _topics = [];
    private bool _newestFirst = true;
    private int _currentPage = 1;
    private bool _isLoading = true;
    private bool _restoredFromPrerender;
    private PersistingComponentStateSubscription _persisting;

    // The question the address asks. The URL is the one source of truth for what this screen
    // shows: every control navigates, and this page only ever renders what its address says —
    // which is what makes a search shareable, a bookmark honest, and the back button undo a
    // filter instead of leaving the catalog.
    /// <summary>What to look for, from the address.</summary>
    [SupplyParameterFromQuery(Name = "term")]
    public string? TermParameter { get; set; }

    /// <summary>The shelf to browse, from the address.</summary>
    [SupplyParameterFromQuery(Name = "topic")]
    public string[]? TopicParameter { get; set; }

    /// <summary>The order to read in, from the address (ADR 0071).</summary>
    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortParameter { get; set; }

    /// <summary>The page to show, from the address.</summary>
    [SupplyParameterFromQuery(Name = "page")]
    public int? PageParameter { get; set; }

    // What the contract calls the non-default order. The default — newest first, since the
    // catalog became the front door (ADR 0074) — travels as no parameter at all, so the address
    // of an unsorted catalog stays what it always was.
    private string? Sort => _newestFirst ? null : "title";

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _persisting = ApplicationState.RegisterOnPersisting(Persist);

        // The prerendered pass already asked the address's own question; taking its answer is
        // what keeps the first paint from being replaced by a spinner and the API from being
        // asked twice (ADR 0072).
        if (ApplicationState.TryTakeFromJson<PagedHttpResponseOfCatalogTrainingHttpResponse?>(
                PageKey, out var prerendered)
            && prerendered is not null)
        {
            ApplicationState.TryTakeFromJson(FacetsKey, out _facets);
            _page = prerendered;
            _isLoading = false;
            _restoredFromPrerender = true;
        }
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        var term = string.IsNullOrWhiteSpace(TermParameter) ? null : TermParameter;
        var topics = Shelved(TopicParameter);

        // Anything that is not the named alternative reads as the default, so an address with no
        // sort — and one carrying a name the contract would refuse — both ask for newest.
        var newestFirst = !string.Equals(SortParameter, "title", StringComparison.OrdinalIgnoreCase);
        var page = PageParameter is > 0 ? PageParameter.Value : 1;

        var alreadyShowing = !_isLoading
            && term == _term
            && topics.SequenceEqual(_topics, StringComparer.Ordinal)
            && newestFirst == _newestFirst
            && page == _currentPage;

        var termChanged = term != _term;

        _term = term;
        _topics = topics;
        _newestFirst = newestFirst;
        _currentPage = page;

        // The prerendered answer is the answer to this very address, so the first parameter pass
        // has nothing to ask; every later pass is a navigation, and a navigation is a question.
        if (_restoredFromPrerender)
        {
            _restoredFromPrerender = false;
            return;
        }

        if (alreadyShowing)
        {
            return;
        }

        // The counts answer the term (ADR 0080), so they are stale the moment it moves — not
        // merely absent. Reloading only when they have never been fetched would leave every chip
        // advertising the whole catalog to a visitor who has typed something.
        if (_facets is null || termChanged)
        {
            await LoadFacetsAsync();
        }

        await LoadAsync();
    }

    private Task Persist()
    {
        // A failed load is not an answer to hand over: the interactive pass should ask again
        // rather than inherit a snackbar it never showed.
        if (_page is not null)
        {
            ApplicationState.PersistAsJson(PageKey, _page);
            ApplicationState.PersistAsJson(FacetsKey, _facets);
        }

        return Task.CompletedTask;
    }

    /// <inheritdoc />
    public void Dispose() => _persisting.Dispose();

    private Task OnTermChangedAsync(string? term)
    {
        Ask(term: term, topics: _topics, newestFirst: _newestFirst, page: 1);
        return Task.CompletedTask;
    }

    private Task OnTopicClickedAsync(string topic)
    {
        // The same chip again lifts the filter rather than reasserting it.
        Ask(term: _term, topics: Toggled(topic), newestFirst: _newestFirst, page: 1);
        return Task.CompletedTask;
    }

    private Task OnTopicsClearedAsync()
    {
        Ask(term: _term, topics: [], newestFirst: _newestFirst, page: 1);
        return Task.CompletedTask;
    }

    private Task OnPageSelectedAsync(int page)
    {
        Ask(term: _term, topics: _topics, newestFirst: _newestFirst, page: page);
        return Task.CompletedTask;
    }

    private Task OnOrderChangedAsync(bool newestFirst)
    {
        if (_newestFirst != newestFirst)
        {
            Ask(term: _term, topics: _topics, newestFirst: newestFirst, page: 1);
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Asks by navigating: the address changes, the router hands the parameters back, and the
    /// load follows from them. Defaults travel as no parameter at all, so the plain catalog
    /// keeps the address it always had.
    /// </summary>
    private void Ask(string? term, IReadOnlyList<string> topics, bool newestFirst, int page) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["term"] = string.IsNullOrWhiteSpace(term) ? null : term,
            // Repeated rather than joined, and sorted rather than in the order they were ticked:
            // one selection is one address, which is what keeps the canonical below from having a
            // spelling per click order (ADR 0073, ADR 0080). An empty selection is no parameter at
            // all, exactly as a blank term and a first page are.
            ["topic"] = topics.Count == 0 ? null : topics.ToArray(),
            ["sort"] = newestFirst ? null : "title",
            ["page"] = page == 1 ? null : page
        }));

    /// <summary>The shelves an address asks for: blanks dropped, duplicates collapsed, sorted.</summary>
    /// <remarks>
    /// Sorted here rather than at the point of writing, so that an address typed by hand and one
    /// this page wrote are read as the same question — and so the <c>alreadyShowing</c> comparison
    /// above can be a sequence comparison rather than a set one.
    /// </remarks>
    private static IReadOnlyList<string> Shelved(string[]? asked) =>
        asked is null
            ? []
            : [.. asked
                .Where(topic => !string.IsNullOrWhiteSpace(topic))
                .Distinct(StringComparer.Ordinal)
                .OrderBy(topic => topic, StringComparer.Ordinal)];

    /// <summary>The selection with that shelf added, or removed when it was already there.</summary>
    /// <remarks>
    /// The multi-select reading of what a chip does. Clicking one that is already lit still lifts
    /// it — the gesture is unchanged, it just no longer takes the others with it.
    /// </remarks>
    private IReadOnlyList<string> Toggled(string topic) =>
        Shelved(_topics.Contains(topic)
            ? [.. _topics.Where(shelf => !string.Equals(shelf, topic, StringComparison.Ordinal))]
            : [.. _topics, topic]);

    /// <summary>The shelves as the address spells them, or nothing when none is picked.</summary>
    private string[]? Shelves => _topics.Count == 0 ? null : _topics.ToArray();

    private async Task LoadFacetsAsync()
    {
        try
        {
            _facets = (await CatalogClient.GetTopicsAsync(_term)).Topics;
        }
        catch (Exception)
        {
            // Losing the chips costs browsing comfort, not the catalog: the search below answers
            // without them, so this failure stays silent rather than doubling the snackbar.
            _facets = null;
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            // Asked with the address's own spelling — no shelf is no parameter, not an empty list
            // — so the question the API is asked is the question the address shows.
            _page = await CatalogClient.SearchTrainingsAsync(_term, Shelves, Sort, _currentPage, null);

            if (_currentPage > _page.TotalPages)
            {
                _currentPage = _page.TotalPages;
                _page = await CatalogClient.SearchTrainingsAsync(_term, Shelves, Sort, _currentPage, null);
            }
        }
        catch (ApiException<ProblemDetails> exception)
        {
            // The one declared refusal of this read is a 400 on the address's own parameters —
            // term, shelves, sort, page all come from the URL — and the document says which one
            // was refused better than any sentence of ours (ADR 0004).
            foreach (var message in ProblemDetailsMessages.Read(exception.Result, Common["RequestRejected"]))
            {
                Snackbar.Add(message, Severity.Error);
            }
        }
        catch (ApiException exception)
        {
            // ApiException.Message is the generator's own sentence and the raw body with it; it
            // belongs in the console, not on screen.
            Console.Error.WriteLine(exception);
            Snackbar.Add(L["CatalogLoadFailedRetry"], Severity.Error);
        }
        catch (Exception exception)
        {
            // Whatever this is, it is ours; a visitor learns nothing from a stack of it.
            Console.Error.WriteLine(exception);
            Snackbar.Add(L["CatalogLoadFailed"], Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
