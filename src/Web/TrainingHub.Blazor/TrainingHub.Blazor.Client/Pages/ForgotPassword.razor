@page "/forgot-password"
@using TrainingHub.Blazor.Client.Infrastructure
@inject IBffSessionClient SessionClient
@inject ISnackbar Snackbar
@inject IStringLocalizer<AuthenticationResources> L
@inject IStringLocalizer<CommonResources> Common

<PageTitle>@L["ForgotPasswordPageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="height: 80vh;">
    <MudPaper Elevation="4" Class="pa-8 w-100 th-sheet th-auth">
        @* The desk's spine is brass — the identity's own metal, the one the avatar wears. *@
        <span class="th-sheet-spine" aria-hidden="true">
            <span style="background-color: var(--mud-palette-secondary)"></span>
        </span>

        <MudStack Spacing="4">
            <MudText Typo="Typo.h4">@L["ForgotYourPassword"]</MudText>

            @if (_sent)
            {
                @* One sentence for every address, known or not: the page never says whether an
                   account exists, because that is the whole discipline (ADR 0084). *@
                <MudText Typo="Typo.body1">
                    @L["ResetLinkSent"]
                </MudText>

                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                    <MudLink Href="/login" Typo="Typo.body2">@L["BackToSignIn"]</MudLink>
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2">
                    @L["ForgotIntro"]
                </MudText>

                <MudForm @ref="_form" @bind-IsValid="_isValid" OnEnterPressed="HandleSubmit">
                    <MudTextField @bind-Value="_email"
                                  Label="@L["EmailLabel"]"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="@L["EmailRequired"]"
                                  Immediate="true"
                                  Disabled="_isLoading" />
                </MudForm>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@(!_isValid || _isLoading)"
                           OnClick="HandleSubmit"
                           Class="mt-4">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>@L["Sending"]</span>
                    }
                    else
                    {
                        <span>@L["SendTheResetLink"]</span>
                    }
                </MudButton>

                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                    @L["RememberedAfterAll"]
                    <MudLink Href="/login" Typo="Typo.body2">@Common["SignIn"]</MudLink>
                </MudText>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private MudForm _form = null!;
    private bool _isValid;
    private bool _isLoading;
    private bool _sent;
    private string _email = string.Empty;

    private async Task HandleSubmit()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        _isLoading = true;
        try
        {
            var taken = await SessionClient.ForgotPasswordAsync(_email);

            if (!taken)
            {
                Snackbar.Add(L["TooManyRequests"], Severity.Warning);
                return;
            }

            // The confirmation replaces the form rather than sitting beside it: there is nothing
            // more to type, and re-sending is the "ask again" the sentence already covers.
            _sent = true;
        }
        catch (Exception ex)
        {
            // The detail is ours, not the user's — the sign-in page's rule, for the same reason.
            Console.Error.WriteLine(ex);
            Snackbar.Add(L["RecoveryUnavailable"], Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
