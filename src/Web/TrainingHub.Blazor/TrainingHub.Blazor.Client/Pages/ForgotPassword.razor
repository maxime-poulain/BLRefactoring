@page "/forgot-password"
@using TrainingHub.Blazor.Client.Infrastructure
@inject IBffSessionClient SessionClient
@inject ISnackbar Snackbar

<PageTitle>Forgot password — TrainingHub</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="height: 80vh;">
    <MudPaper Elevation="4" Class="pa-8 w-100 th-sheet th-auth">
        @* The desk's spine is brass — the identity's own metal, the one the avatar wears. *@
        <span class="th-sheet-spine" aria-hidden="true">
            <span style="background-color: var(--mud-palette-secondary)"></span>
        </span>

        <MudStack Spacing="4">
            <MudText Typo="Typo.h4">Forgot your password?</MudText>

            @if (_sent)
            {
                @* One sentence for every address, known or not: the page never says whether an
                   account exists, because that is the whole discipline (ADR 0084). *@
                <MudText Typo="Typo.body1">
                    If an account exists for this address, a message with a reset link is on its
                    way. The link works for 15 minutes — and if you ask again, only the newest
                    email counts.
                </MudText>

                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                    <MudLink Href="/login" Typo="Typo.body2">Back to sign-in</MudLink>
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2">
                    Enter your account email and we will send you a link to choose a new password.
                </MudText>

                <MudForm @ref="_form" @bind-IsValid="_isValid">
                    <MudTextField @bind-Value="_email"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Email is required"
                                  Immediate="true"
                                  Disabled="_isLoading" />
                </MudForm>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@(!_isValid || _isLoading)"
                           OnClick="HandleSubmit"
                           Class="mt-4">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send the reset link</span>
                    }
                </MudButton>

                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                    Remembered it after all?
                    <MudLink Href="/login" Typo="Typo.body2">Sign in</MudLink>
                </MudText>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private MudForm _form = null!;
    private bool _isValid;
    private bool _isLoading;
    private bool _sent;
    private string _email = string.Empty;

    private async Task HandleSubmit()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        _isLoading = true;
        try
        {
            var taken = await SessionClient.ForgotPasswordAsync(_email);

            if (!taken)
            {
                Snackbar.Add("Too many requests. Wait a few minutes and try again.", Severity.Warning);
                return;
            }

            // The confirmation replaces the form rather than sitting beside it: there is nothing
            // more to type, and re-sending is the "ask again" the sentence already covers.
            _sent = true;
        }
        catch (Exception ex)
        {
            // The detail is ours, not the user's — the sign-in page's rule, for the same reason.
            Console.Error.WriteLine(ex);
            Snackbar.Add("Password recovery is unavailable right now. Try again in a moment.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
