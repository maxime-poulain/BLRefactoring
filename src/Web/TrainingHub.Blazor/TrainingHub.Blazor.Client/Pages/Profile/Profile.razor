@page "/profile"
@attribute [Authorize(Policy = SessionPolicies.Trainer)]
@using TrainingHub.GeneratedClients
@inject ITrainerClient TrainerClient
@inject NavigationManager NavigationManager
@using TrainingHub.Blazor.Client.Infrastructure
@inject ISnackbar Snackbar
@inject ITrainerStandingSource StandingSource
@inject IDialogService DialogService
@inject IBffSessionClient SessionClient
@inject IAuthenticationStateNotifier AuthenticationNotifier
@inject IStringLocalizer<TrainerResources> L
@inject IStringLocalizer<CommonResources> Common

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-4">
    <MudPaper Elevation="4" Class="pa-8">
        @if (_isLoadingData)
        {
            <MudStack AlignItems="AlignItems.Center" Class="my-8">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.body1" Class="mt-4">@L["LoadingProfile"]</MudText>
            </MudStack>
        }
        else
        {
            <MudStack Spacing="4">
                <MudText Typo="Typo.h4">@L["MyProfile"]</MudText>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="6" Class="mt-2">
                    <MudAvatar Style="height: 128px; width: 128px;" Color="Color.Primary">
                        @if (_photoUrl is not null)
                        {
                            <MudImage Src="@_photoUrl" Alt="@L["ProfilePhotoAlt"]" ObjectFit="ObjectFit.Cover"
                                      Height="128" Width="128" />
                        }
                        else
                        {
                            @Initials
                        }
                    </MudAvatar>

                    <MudStack Spacing="2">
                        <MudFileUpload T="IBrowserFile"
                                       Accept="@AcceptedTypes"
                                       MaximumFileCount="1"
                                       FilesChanged="HandlePhotoSelected"
                                       Disabled="@(_isUploading || _standing.IsSuspended)">
                            <CustomContent Context="upload">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.PhotoCamera"
                                           Disabled="@(_isUploading || _standing.IsSuspended)"
                                           OnClick="@(() => upload.OpenFilePickerAsync())">
                                    @(_hasPhoto ? L["ChangePhoto"] : L["AddAPhoto"])
                                </MudButton>
                            </CustomContent>
                        </MudFileUpload>

                        @if (_hasPhoto)
                        {
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       Disabled="@(_isUploading || _standing.IsSuspended)"
                                       OnClick="HandlePhotoRemoved">
                                @L["RemovePhoto"]
                            </MudButton>
                        }

                        <MudText Typo="Typo.caption">
                            @L["PhotoFormats", MaxSizeInMebibytes]
                        </MudText>
                    </MudStack>
                </MudStack>

                @if (_isUploading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
                }

                @if (_photoError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_photoError</MudAlert>
                }

                <MudDivider Class="my-2" />

                <MudForm @ref="_form" @bind-IsValid="_isValid">
                    <MudTextField @bind-Value="_firstname"
                                  Label="@Common["FirstName"]"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="@L["FirstNameRequired"]"
                                  Immediate="true"
                                  MaxLength="NameMaxLength"
                                  Disabled="_isSaving" />

                    <MudTextField @bind-Value="_lastname"
                                  Label="@Common["LastName"]"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="@L["LastNameRequired"]"
                                  Immediate="true"
                                  MaxLength="NameMaxLength"
                                  Disabled="_isSaving"
                                  Class="mt-4" />

                    <MudTextField @bind-Value="_contactEmail"
                                  Label="@L["ContactEmail"]"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="@L["ContactEmailRequired"]"
                                  Immediate="true"
                                  Disabled="_isSaving"
                                  HelperText="@L["ContactEmailHelper"]"
                                  Class="mt-4" />

                    <MudTextField @bind-Value="_bio"
                                  Label="@L["BioLabel"]"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Lines="4"
                                  Counter="BioMaxLength"
                                  MaxLength="BioMaxLength"
                                  Disabled="_isSaving"
                                  Class="mt-4" />
                </MudForm>

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               Disabled="_isSaving"
                               OnClick="@(() => NavigationManager.NavigateTo("/trainings"))">
                        @Common["Cancel"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@(!_isValid || _isSaving || _standing.IsSuspended)"
                               OnClick="HandleSubmit">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>@L["Saving"]</span>
                        }
                        else
                        {
                            <span>@L["SaveChanges"]</span>
                        }
                    </MudButton>
                </MudStack>

                <MudDivider Class="my-2" />

                @* Deliberately not disabled by _standing.IsSuspended: a suspension takes the
                   catalog away, never the right to leave. Erasing the account is the one write
                   the sanction does not withhold (ADR 0085). *@
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">@L["EraseThisAccount"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @L["EraseExplanation"]
                    </MudText>
                    <div>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.DeleteForever"
                                   Disabled="_isErasing"
                                   OnClick="HandleEraseAccount">
                            @L["EraseAccount"]
                        </MudButton>
                    </div>
                </MudStack>
            </MudStack>
        }
    </MudPaper>
</MudContainer>

@code {
    // Read once per page through the shared source, so the layout's banner and these controls never
    // disagree about the same sanction (ADR 0057).
    private TrainerStanding _standing = TrainerStanding.Active;

    /// <summary>412, as the API answers an edit based on a version that is no longer current.</summary>
    private const int StatusPreconditionFailed = 412;

    private const int NameMaxLength = 50;
    private const int BioMaxLength = 500;

    /// <summary>
    /// The same ceiling the API enforces, restated here to refuse a file before it is uploaded.
    /// </summary>
    /// <remarks>
    /// A mirror, never a replacement. The server reads the bytes and is the only thing that can
    /// tell an image from a renamed one; this exists so that choosing a 40 MiB photo says so at
    /// once instead of after the upload. The number is duplicated across a network boundary, which
    /// is the ordinary cost of client-side validation — the server's answer still wins.
    /// </remarks>
    private const int MaxSizeInMebibytes = 5;

    private const long MaxSizeInBytes = MaxSizeInMebibytes * 1024 * 1024;

    private const string AcceptedTypes = "image/png,image/jpeg,image/webp";

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isLoadingData;
    private bool _isSaving;
    private bool _isUploading;
    private bool _isErasing;

    private Guid _trainerId;
    private string _firstname = string.Empty;
    private string _lastname = string.Empty;
    private string _contactEmail = string.Empty;
    private string _bio = string.Empty;
    private bool _hasPhoto;
    private string? _photoUrl;
    private string? _photoError;

    /// <summary>
    /// The version this page read, to be sent back when saving.
    /// </summary>
    /// <remarks>
    /// Without it the API answers 428 and refuses the edit. It is never refreshed behind the
    /// user's back: fetching a newer version to retry with is exactly the overwrite this mechanism
    /// exists to prevent. See ADR 0010.
    /// </remarks>
    private string? _version;

    private string Initials =>
        string.Concat(
            _firstname.Length > 0 ? _firstname[..1] : string.Empty,
            _lastname.Length > 0 ? _lastname[..1] : string.Empty);

    protected override async Task OnInitializedAsync()
    {
        _standing = await StandingSource.GetAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoadingData = true;
        try
        {
            var read = await TrainerClient.GetCurrentAsync();

            _version = read.Headers.TryGetValue("ETag", out var etag) ? etag.FirstOrDefault() : null;

            Apply(read.Result);
        }
        catch (ApiException<ProblemDetails> exception)
        {
            // The declared 404: the trainer behind this session is gone. The document says so in
            // the API's own words (ADR 0004).
            foreach (var message in ProblemDetailsMessages.Read(exception.Result, Common["RequestRejected"]))
            {
                Snackbar.Add(message, Severity.Error);
            }
        }
        catch (ApiException exception)
        {
            // exception.Message here is the generator's own sentence — "The HTTP status code of
            // the response was not expected (503)." It belongs in the console, not on screen.
            Console.Error.WriteLine(exception);
            Snackbar.Add(L["ProfileLoadFailedRetry"], Severity.Error);
        }
        catch (Exception exception)
        {
            // Whatever this is, it is ours. A NullReferenceException must not become UI copy.
            Console.Error.WriteLine(exception);
            Snackbar.Add(L["ProfileLoadFailedWrong"], Severity.Error);
        }
        finally
        {
            _isLoadingData = false;
        }
    }

    private void Apply(TrainerHttpResponse trainer)
    {
        _trainerId = trainer.Id;
        _firstname = trainer.Firstname;
        _lastname = trainer.Lastname;
        _contactEmail = trainer.ContactEmail;
        _bio = trainer.Bio ?? string.Empty;
        _hasPhoto = trainer.PhotoId is not null;

        // The photo identity goes in the query string as a cache buster, which is a workaround
        // rather than a design: this endpoint's address does not name the photo, so its bytes do
        // change and its response says max-age with an ETag rather than immutable (ADR 0063). The
        // ?v= is what makes a replacement visible before the year is out. The public portrait needs
        // none of this — it carries the identity in the path, so its address genuinely never
        // changes meaning.
        _photoUrl = _hasPhoto
            ? $"api/Trainer/{trainer.Id}/photo?v={trainer.PhotoId}"
            : null;
    }

    private async Task HandlePhotoSelected(IBrowserFile? file)
    {
        _photoError = null;

        if (file is null)
        {
            return;
        }

        if (file.Size > MaxSizeInBytes)
        {
            _photoError = L["PhotoTooLarge", file.Size / 1024 / 1024, MaxSizeInMebibytes];
            return;
        }

        _isUploading = true;
        try
        {
            // Read once, into memory. The file is bounded by the check above, and the generated
            // client needs a stream it can hand to a multipart part.
            await using var upload = file.OpenReadStream(MaxSizeInBytes);
            using var buffer = new MemoryStream();
            await upload.CopyToAsync(buffer);
            buffer.Position = 0;

            var updated = await TrainerClient.SetPhotoAsync(
                new FileParameter(buffer, file.Name, file.ContentType));

            Apply(updated);

            // The photo write bumped the row's version, so the ETag this page holds no longer
            // names the current row — and the response body cannot carry the new one, because the
            // ETag is a header, never a field. Reloading is what gets the next edit a version the
            // server will accept; without it, saving the profile after changing the photo answers
            // 412 with nobody else involved.
            await LoadAsync();

            Snackbar.Add(L["PhotoUpdated"], Severity.Success);
        }
        catch (ApiException<ProblemDetails> exception)
        {
            // The server is the authority on what an image is, so its refusal is shown as written
            // rather than reworded into a guess about which rule was broken — read from the
            // problem document, never from the raw response body.
            _photoError = string.Join(
                " ",
                ProblemDetailsMessages.Read(exception.Result, L["PhotoUploadFailed"]));
        }
        catch (ApiException exception)
        {
            // With no readable document, the generator's own sentence must not become interface
            // copy: it goes to the console, and a sentence of ours goes on screen.
            Console.Error.WriteLine(exception);
            _photoError = L["PhotoUploadFailedRetry"];
        }
        catch (Exception exception)
        {
            // Whatever this is, it is ours. A NullReferenceException must not become UI copy.
            Console.Error.WriteLine(exception);
            _photoError = L["PhotoUploadFailedWrong"];
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task HandlePhotoRemoved()
    {
        _photoError = null;
        _isUploading = true;

        try
        {
            await TrainerClient.DeletePhotoAsync();

            // The reload answers both halves at once: the cleared photo, and the fresh ETag the
            // removal minted — the same staleness the upload path explains above.
            await LoadAsync();

            Snackbar.Add(L["PhotoRemoved"], Severity.Success);
        }
        catch (ApiException<ProblemDetails> exception)
        {
            _photoError = string.Join(
                " ",
                ProblemDetailsMessages.Read(exception.Result, L["PhotoRemoveFailed"]));
        }
        catch (ApiException exception)
        {
            Console.Error.WriteLine(exception);
            _photoError = L["PhotoRemoveFailedRetry"];
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            _photoError = L["PhotoRemoveFailedWrong"];
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task HandleSubmit()
    {
        await _form.ValidateAsync();

        if (!_isValid)
        {
            return;
        }

        _isSaving = true;
        try
        {
            var updated = await TrainerClient.EditCurrentAsync(
                _version,
                new EditTrainerHttpRequest
                {
                    Firstname = _firstname,
                    Lastname = _lastname,
                    ContactEmail = _contactEmail,
                    Bio = string.IsNullOrWhiteSpace(_bio) ? null : _bio
                });

            Apply(updated);

            // The version this page holds is now stale by definition, and the response body does
            // not carry the new one — the ETag is a header, never a field. Reloading is what gets
            // the next edit a version the server will accept.
            await LoadAsync();

            Snackbar.Add(L["ProfileSaved"], Severity.Success);
        }
        catch (ApiException<ProblemDetails> exception) when (exception.StatusCode == StatusPreconditionFailed)
        {
            // The declared 412: the sentence is ours because the document describes a version
            // mismatch rather than what happened to the person editing.
            Snackbar.Add(L["ProfileEditConflict"], Severity.Warning);
        }
        catch (ApiException<ProblemDetails> exception)
        {
            // The 400, the 404 and the 428 all arrive as problem documents, and the messages are
            // the server's own — per field when the contract refused, per domain error when the
            // aggregate did (ADR 0004).
            foreach (var message in ProblemDetailsMessages.Read(exception.Result, Common["RequestRejected"]))
            {
                Snackbar.Add(message, Severity.Error);
            }
        }
        catch (ApiException exception)
        {
            Console.Error.WriteLine(exception);
            Snackbar.Add(L["ProfileSaveFailedRetry"], Severity.Error);
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            Snackbar.Add(L["ProfileSaveFailedWrong"], Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task HandleEraseAccount()
    {
        var password = await EraseAccountDialogs.AskAsync(DialogService, L["EraseThisAccountTitle"]);

        if (password is null)
        {
            return;
        }

        _isErasing = true;
        try
        {
            var problem = await SessionClient.EraseAccountAsync(password);

            if (problem is not null)
            {
                // The wrong password arrives keyed to its field, and the sentence inside the
                // document is the one the API wrote — shown as written, like every refusal here.
                foreach (var message in ProblemDetailsMessages.Read(problem, L["EraseFailed"]))
                {
                    Snackbar.Add(message, Severity.Error);
                }

                return;
            }

            // The BFF has already signed the session out; what is left is telling the interface.
            Snackbar.Add(L["AccountErased"], Severity.Success);
            AuthenticationNotifier.NotifyAuthenticationChanged();
            NavigationManager.NavigateTo("/");
        }
        catch (HttpRequestException exception)
        {
            Console.Error.WriteLine(exception);
            Snackbar.Add(L["EraseFailedRetry"], Severity.Error);
        }
        finally
        {
            _isErasing = false;
        }
    }

}
