@page "/login"
@using TrainingHub.Blazor.Client.Infrastructure
@inject IBffSessionClient SessionClient
@inject IAuthenticationStateNotifier AuthenticationNotifier
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IStringLocalizer<AuthenticationResources> L
@inject IStringLocalizer<CommonResources> Common

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="height: 80vh;">
    <MudPaper Elevation="4" Class="pa-8 w-100 th-sheet th-auth">
        @* The desk's spine is brass — the identity's own metal, the one the avatar wears. *@
        <span class="th-sheet-spine" aria-hidden="true">
            <span style="background-color: var(--mud-palette-secondary)"></span>
        </span>

        <MudStack Spacing="4">
            <MudText Typo="Typo.h4">@Common["SignIn"]</MudText>

            <MudForm @ref="_form" @bind-IsValid="_isValid" OnEnterPressed="HandleLogin">
                <MudTextField @bind-Value="_username"
                              Label="@L["UsernameLabel"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@L["UsernameRequired"]"
                              Immediate="true"
                              Disabled="_isLoading" />

                <MudTextField @bind-Value="_password"
                              Label="@L["PasswordLabel"]"
                              Variant="Variant.Outlined"
                              InputType="@_passwordInputType"
                              Required="true"
                              RequiredError="@L["PasswordRequired"]"
                              Immediate="true"
                              Disabled="_isLoading"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordIcon"
                              OnAdornmentClick="TogglePasswordVisibility"
                              Class="mt-4" />
            </MudForm>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="@(!_isValid || _isLoading)"
                       OnClick="HandleLogin"
                       Class="mt-4">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>@L["SigningIn"]</span>
                }
                else
                {
                    <span>@Common["SignIn"]</span>
                }
            </MudButton>

            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                <MudLink Href="/forgot-password" Typo="Typo.body2">@L["ForgotYourPassword"]</MudLink>
            </MudText>

            <MudText Typo="Typo.body2" Align="Align.Center">
                @L["DontHaveAccount"]
                <MudLink Href="/register" Typo="Typo.body2">@L["RegisterHere"]</MudLink>
            </MudText>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    /// <summary>
    /// Where to go once signed in, as <c>RouteRefusal</c> recorded it.
    /// </summary>
    /// <remarks>
    /// Only a path is honored. The value arrives from the address bar, so anything that could name
    /// another origin — an absolute URL, or the protocol-relative <c>//evil.example</c> that
    /// <c>Uri.IsWellFormedUriString(..., Relative)</c> happily accepts — is discarded in favor of
    /// the catalog. Redirecting to wherever a query string says is how a sign-in page becomes a
    /// phishing hop.
    /// </remarks>
    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrlParameter { get; set; }

    private string? ReturnUrl =>
        ReturnUrlParameter is not null
        && ReturnUrlParameter.StartsWith('/')
        && !ReturnUrlParameter.StartsWith("//", StringComparison.Ordinal)
            ? ReturnUrlParameter
            : null;

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isLoading;
    private string _username = string.Empty;
    private string _password = string.Empty;
    private bool _passwordVisible;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    /// <summary>
    /// The page a caller lands on when they asked for no page in particular.
    /// </summary>
    /// <remarks>
    /// Chosen by what the caller is, from the identity the BFF has just re-read — the notifier
    /// above drops the cached answer, so this asks the cookie rather than a memory of it. Sending
    /// everybody to the trainer's space was the defect this replaces: an administrator is nobody's
    /// trainer, and landed on a page the API refuses them (ADR 0051, ADR 0078).
    /// <para>
    /// The order settles the account that is both. A trainer with the administrator's role goes to
    /// their own work, because that is what they are most of the time, and the administration stays
    /// one click away in the corner — whereas the reverse would hide a person's own trainings
    /// behind an authority they use occasionally.
    /// </para>
    /// </remarks>
    private async Task<string> LandingAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        if (user.HasClaim(claim => claim.Type == SessionClaims.TrainerId))
        {
            return "/trainings";
        }

        // Not a trainer, and not an administrator either: an account with neither is a caller this
        // application has no space for, and the catalog is the one page that asks nothing of
        // anybody (ADR 0074).
        return user.IsInRole(SessionRoles.Administrator) ? "/administration" : "/";
    }

    private void TogglePasswordVisibility()
    {
        _passwordVisible = !_passwordVisible;
        _passwordInputType = _passwordVisible ? InputType.Text : InputType.Password;
        _passwordIcon = _passwordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private async Task HandleLogin()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        _isLoading = true;
        try
        {
            // No token comes back, and that is the point: the BFF holds it and hands this page a
            // cookie it cannot read. Identity is then whatever /bff/user reports. See ADR 0009.
            var signedIn = await SessionClient.LoginAsync(_username, _password);

            if (!signedIn)
            {
                Snackbar.Add(L["InvalidCredentials"], Severity.Error);
                return;
            }

            AuthenticationNotifier.NotifyAuthenticationChanged();

            Snackbar.Add(L["SignedIn"], Severity.Success);
            NavigationManager.NavigateTo(ReturnUrl ?? await LandingAsync());
        }
        catch (Exception ex)
        {
            // The detail is ours, not the user's: an exception message is an implementation
            // detail on a sign-in page, and a NullReferenceException rendered as UI copy tells
            // an attacker more than it tells anyone else.
            Console.Error.WriteLine(ex);
            Snackbar.Add(L["SignInUnavailable"], Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
