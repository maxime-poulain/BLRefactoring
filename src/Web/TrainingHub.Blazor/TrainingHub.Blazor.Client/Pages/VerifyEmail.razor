@page "/verify-email"
@using TrainingHub.Blazor.Client.Infrastructure
@inject IBffSessionClient SessionClient
@inject ITrainerStandingSource StandingSource
@inject ISnackbar Snackbar
@inject IStringLocalizer<AuthenticationResources> L
@inject IStringLocalizer<CommonResources> Common

<PageTitle>@L["VerifyEmailPageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="min-height: 80vh;">
    <MudPaper Elevation="4" Class="pa-8 w-100 my-4 th-sheet th-auth">
        @* The desk's spine is brass — the identity's own metal, the one the avatar wears. *@
        <span class="th-sheet-spine" aria-hidden="true">
            <span style="background-color: var(--mud-palette-secondary)"></span>
        </span>

        <MudStack Spacing="4">
            <MudText Typo="Typo.h4">@L["VerifyEmailPageTitle"]</MudText>

            @if (string.IsNullOrWhiteSpace(Token))
            {
                @* A verification page reached without its token has nothing to redeem — the state
                   a truncated or hand-typed address lands on, told apart from a dead link because
                   nothing was even tried (ADR 0084's distinction, one credential over). *@
                <MudText Typo="Typo.body1">
                    @L["VerifyEmailMissingToken"]
                </MudText>
            }
            else if (_isVerified)
            {
                <MudText Typo="Typo.body1">@L["EmailVerified"]</MudText>

                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                    <MudLink Href="/login" Typo="Typo.body2">@Common["SignIn"]</MudLink>
                </MudText>
            }
            else
            {
                @* The click is deliberate: inbox scanners open every address an email carries,
                   and a redemption on load would let a machine spend the credential before its
                   owner ever saw the page. The token is spent by this button and nothing else
                   (ADR 0090). *@
                <MudText Typo="Typo.body2">
                    @L["VerifyEmailIntro"]
                </MudText>

                @if (_isDeadLink)
                {
                    @* The one sentence for every way a link can be dead, rendered here because
                       the BFF passes only the status through — and the second half exists
                       because "already used" is usually the happy path's own echo: the visitor
                       who double-clicked has nothing to fix but signing in (ADR 0090). *@
                    <MudAlert Severity="Severity.Warning" Class="mt-2">
                        @L["DeadVerificationLink"]
                    </MudAlert>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="_isLoading"
                           OnClick="ConfirmAsync"
                           Class="mt-4">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>@L["ConfirmingYourAddress"]</span>
                    }
                    else
                    {
                        <span>@L["ConfirmMyAddress"]</span>
                    }
                </MudButton>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    /// <summary>
    /// The verification token, exactly as the emailed link carried it — the only thing the link
    /// carries at all: no address, no identifier, nothing personally identifying in a browser's
    /// history (ADR 0084's discipline, ADR 0090). It leaves this page in a POST body, never in a
    /// query an access log would keep.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private bool _isLoading;
    private bool _isVerified;
    private bool _isDeadLink;

    private async Task ConfirmAsync()
    {
        _isLoading = true;
        _isDeadLink = false;
        try
        {
            if (await SessionClient.VerifyEmailAsync(Token!))
            {
                _isVerified = true;

                // If a session is watching, the banner dies now rather than at the next sign-in:
                // the standing is read from the database on every refresh, never from the token's
                // claims, which is what makes this work without a logout (ADR 0090). For a
                // visitor with no session the refresh reads nothing and changes nothing.
                await StandingSource.RefreshAsync();
                return;
            }

            _isDeadLink = true;
        }
        catch (Exception exception)
        {
            // The detail is ours, not the user's — the sign-in page's rule, for the same reason.
            Console.Error.WriteLine(exception);
            Snackbar.Add(Common["RequestRejected"], Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
