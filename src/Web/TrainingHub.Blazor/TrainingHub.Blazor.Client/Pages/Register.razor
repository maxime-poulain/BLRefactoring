@page "/register"
@using System.ComponentModel.DataAnnotations
@using System.Linq
@using TrainingHub.Blazor.Client.Infrastructure
@using TrainingHub.GeneratedClients
@inject IBffSessionClient SessionClient
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IStringLocalizer<AuthenticationResources> L

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="min-height: 80vh;">
    <MudPaper Elevation="4" Class="pa-8 w-100 my-4 th-sheet th-auth">
        @* The desk's spine is brass, like the sign-in page it is the other half of. *@
        <span class="th-sheet-spine" aria-hidden="true">
            <span style="background-color: var(--mud-palette-secondary)"></span>
        </span>

        <MudStack Spacing="4">
            <MudText Typo="Typo.h4">@L["CreateAnAccount"]</MudText>

            <MudForm @ref="_form" @bind-IsValid="_isValid" OnEnterPressed="HandleRegister">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_firstname"
                                      Label="@L["FirstNameLabel"]"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="@L["FirstNameRequired"]"
                                      Immediate="true"
                                      Disabled="_isLoading" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_lastname"
                                      Label="@L["LastNameLabel"]"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="@L["LastNameRequired"]"
                                      Immediate="true"
                                      Disabled="_isLoading" />
                    </MudItem>
                </MudGrid>

                <MudTextField @bind-Value="_username"
                              Label="@L["UsernameLabel"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@L["UsernameRequired"]"
                              Immediate="true"
                              Disabled="_isLoading"
                              Class="mt-4" />

                <MudTextField @bind-Value="_email"
                              Label="@L["EmailLabel"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@L["EmailRequired"]"
                              Validation="@(new EmailAddressAttribute { ErrorMessage = L["InvalidEmail"].Value })"
                              Immediate="true"
                              Disabled="_isLoading"
                              InputType="InputType.Email"
                              Class="mt-4" />

                <MudTextField @bind-Value="_password"
                              Label="@L["PasswordLabel"]"
                              Variant="Variant.Outlined"
                              InputType="@_passwordInputType"
                              Required="true"
                              RequiredError="@L["PasswordRequired"]"
                              Immediate="true"
                              Disabled="_isLoading"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordIcon"
                              OnAdornmentClick="TogglePasswordVisibility"
                              Class="mt-4" />

                <MudTextField @bind-Value="_confirmPassword"
                              Label="@L["ConfirmPasswordLabel"]"
                              Variant="Variant.Outlined"
                              InputType="@_passwordInputType"
                              Required="true"
                              RequiredError="@L["ConfirmPasswordRequired"]"
                              Validation="@(new Func<string, string?>(ValidatePasswordMatch))"
                              Immediate="true"
                              Disabled="_isLoading"
                              Class="mt-4" />
            </MudForm>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="@(!_isValid || _isLoading)"
                       OnClick="HandleRegister"
                       Class="mt-4">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>@L["CreatingAccount"]</span>
                }
                else
                {
                    <span>@L["Register"]</span>
                }
            </MudButton>

            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                @L["AlreadyHaveAccount"]
                <MudLink Href="/login" Typo="Typo.body2">@L["SignInHere"]</MudLink>
            </MudText>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private MudForm _form = null!;
    private bool _isValid;
    private bool _isLoading;
    private string _username = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _firstname = string.Empty;
    private string _lastname = string.Empty;
    private bool _passwordVisible;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        _passwordVisible = !_passwordVisible;
        _passwordInputType = _passwordVisible ? InputType.Text : InputType.Password;
        _passwordIcon = _passwordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private string? ValidatePasswordMatch(string confirmPassword)
    {
        if (confirmPassword != _password)
            return L["PasswordsDoNotMatch"];
        return null;
    }

    private async Task HandleRegister()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        _isLoading = true;
        try
        {
            var request = new RegisterHttpRequest
            {
                Username = _username,
                Email = _email,
                Password = _password,
                ConfirmPassword = _confirmPassword,
                Firstname = _firstname,
                Lastname = _lastname
            };

            // Through the BFF's own endpoint, not the generated client: /api/Auth/register sits
            // behind the proxy's session-guarded route, and a visitor creating an account is the
            // one caller who never has a session.
            var problem = await SessionClient.RegisterAsync(request);

            if (problem is null)
            {
                Snackbar.Add(L["AccountCreated"], Severity.Success);
                NavigationManager.NavigateTo("/login");
                return;
            }

            // Registration answers a problem document keyed by field, like every other validation
            // failure this API publishes. The per-field messages are what the user needs
            // ("Email 'x' is already taken."), so they are read out of the map rather than
            // replaced by the generic title above it.
            foreach (var message in ProblemDetailsMessages.Read(problem, L["RegistrationRejected"]))
            {
                Snackbar.Add(message, Severity.Error);
            }
        }
        catch (HttpRequestException ex)
        {
            Console.Error.WriteLine(ex);
            Snackbar.Add(L["RegistrationUnavailable"], Severity.Error);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            Snackbar.Add(L["RegistrationWrong"], Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
