@page "/reset-password"
@using TrainingHub.Blazor.Client.Infrastructure
@using TrainingHub.GeneratedClients
@inject IBffSessionClient SessionClient
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IStringLocalizer<AuthenticationResources> L

<PageTitle>@L["ResetPasswordPageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="min-height: 80vh;">
    <MudPaper Elevation="4" Class="pa-8 w-100 my-4 th-sheet th-auth">
        @* The desk's spine is brass — the identity's own metal, the one the avatar wears. *@
        <span class="th-sheet-spine" aria-hidden="true">
            <span style="background-color: var(--mud-palette-secondary)"></span>
        </span>

        <MudStack Spacing="4">
            <MudText Typo="Typo.h4">@L["ChooseANewPassword"]</MudText>

            @if (string.IsNullOrWhiteSpace(Token))
            {
                @* A reset page reached without its token has nothing to redeem — the state a
                   truncated or hand-typed address lands on, told apart from a dead link because
                   nothing was even tried (ADR 0084). *@
                <MudText Typo="Typo.body1">
                    @L["MissingToken"]
                </MudText>

                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                    <MudLink Href="/forgot-password" Typo="Typo.body2">@L["RequestAResetLink"]</MudLink>
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2">
                    @L["ResetIntro"]
                </MudText>

                <MudForm @ref="_form" @bind-IsValid="_isValid">
                    <MudTextField @bind-Value="_email"
                                  Label="@L["EmailLabel"]"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="@L["EmailRequired"]"
                                  Immediate="true"
                                  Disabled="_isLoading" />

                    <MudTextField @bind-Value="_password"
                                  Label="@L["NewPasswordLabel"]"
                                  Variant="Variant.Outlined"
                                  InputType="@_passwordInputType"
                                  Required="true"
                                  RequiredError="@L["PasswordRequired"]"
                                  Immediate="true"
                                  Disabled="_isLoading"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_passwordIcon"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  Class="mt-4" />

                    <MudTextField @bind-Value="_confirmPassword"
                                  Label="@L["ConfirmNewPasswordLabel"]"
                                  Variant="Variant.Outlined"
                                  InputType="@_passwordInputType"
                                  Required="true"
                                  RequiredError="@L["ConfirmPasswordRequired"]"
                                  Validation="@(new Func<string, string?>(ValidatePasswordMatch))"
                                  Immediate="true"
                                  Disabled="_isLoading"
                                  Class="mt-4" />
                </MudForm>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@(!_isValid || _isLoading)"
                           OnClick="HandleSubmit"
                           Class="mt-4">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>@L["ChangingThePassword"]</span>
                    }
                    else
                    {
                        <span>@L["ChangeThePassword"]</span>
                    }
                </MudButton>

                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
                    @L["LinkExpired"]
                    <MudLink Href="/forgot-password" Typo="Typo.body2">@L["RequestANewOne"]</MudLink>
                </MudText>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    /// <summary>
    /// The reset token, exactly as the emailed link carried it — the only thing the link carries
    /// at all: no address, no identifier, nothing personally identifying in a browser's history
    /// (ADR 0084). The email is typed into the form instead.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private MudForm _form = null!;
    private bool _isValid;
    private bool _isLoading;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _passwordVisible;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        _passwordVisible = !_passwordVisible;
        _passwordInputType = _passwordVisible ? InputType.Text : InputType.Password;
        _passwordIcon = _passwordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private string? ValidatePasswordMatch(string confirmPassword) =>
        confirmPassword != _password ? L["PasswordsDoNotMatch"].Value : null;

    private async Task HandleSubmit()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        _isLoading = true;
        try
        {
            var problem = await SessionClient.ResetPasswordAsync(new ResetPasswordHttpRequest
            {
                Email = _email,
                Token = Token!,
                Password = _password,
                ConfirmPassword = _confirmPassword
            });

            if (problem is not null)
            {
                foreach (var message in ProblemDetailsMessages.Read(problem, L["ResetRejected"]))
                {
                    Snackbar.Add(message, Severity.Error);
                }

                return;
            }

            Snackbar.Add(L["PasswordChanged"], Severity.Success);
            NavigationManager.NavigateTo("/login");
        }
        catch (HttpRequestException ex)
        {
            Console.Error.WriteLine(ex);
            Snackbar.Add(L["RecoveryUnavailable"], Severity.Error);
        }
        catch (Exception ex)
        {
            // The detail is ours, not the user's — the sign-in page's rule, for the same reason.
            Console.Error.WriteLine(ex);
            Snackbar.Add(L["SomethingWentWrongRetry"], Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
