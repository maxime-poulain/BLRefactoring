@page "/trainings"
@attribute [Authorize(Policy = SessionPolicies.Trainer)]
@using TrainingHub.GeneratedClients
@inject ITrainingClient TrainingClient
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@using TrainingHub.Blazor.Client.Infrastructure
@inject ISnackbar Snackbar
@inject ITrainerStandingSource StandingSource
@inject IStringLocalizer<TrainingResources> L
@inject IStringLocalizer<CommonResources> Common

<MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">@L["Trainings"]</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/trainings/create"
                   Disabled="@_standing.IsSuspended">
            @L["CreateTraining"]
        </MudButton>
    </MudStack>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="my-8">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4">@L["LoadingTrainings"]</MudText>
        </MudStack>
    }
    else if (_page is null || _page.Items.Count == 0)
    {
        <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.School"
                     Style="font-size: 8rem;"
                     Color="Color.Default"
                     Class="mb-4" />
            <MudText Typo="Typo.h5" Color="Color.Default" Class="mb-2">@L["NoTrainingsYet"]</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                @L["NoTrainingsYetBody"]
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/trainings/create"
                   Disabled="@_standing.IsSuspended">
                @L["CreateTraining"]
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            @foreach (var training in _page.Items)
            {
                <MudItem xs="12" sm="6" md="4">
                    @* The card's own surface carries the status, so a trainer reads their
                       catalog at a glance instead of card by card. A withdrawn one sits on the
                       theme's recessed surface — the same one MudBlazor gives a data grid's group
                       rows — while a published one keeps the default and is not touched. *@
                    <MudCard Elevation="3" Class="@CardClass(training)">
                        <MudCardContent>
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-2">
                                <MudText Typo="Typo.h6">@training.Title</MudText>
                                @* Published is what a training is unless something happened to it,
                                   so it wears no badge: one on every card would make the badge that
                                   matters harder to see. The other two are not the same thing and
                                   are not shown as one — withdrawn is a decision its owner took,
                                   withheld is one taken from them (ADR 0052). *@
                                @if (IsWithheld(training))
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Error"
                                             Variant="Variant.Filled">
                                        @L["WithheldBadge"]
                                    </MudChip>
                                }
                                else if (!IsPublished(training))
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Warning"
                                             Variant="Variant.Filled">
                                        @L["UnpublishedBadge"]
                                    </MudChip>
                                }
                            </MudStack>
                            @* The reason, on the card rather than behind a click. ADR 0052 asked
                               for exactly this and left it open; a third state rendered without it
                               tells its owner that something happened and not what. *@
                            @if (IsWithheld(training))
                            {
                                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                                    <MudText Typo="Typo.body2">@training.WithholdingReason</MudText>
                                    <MudText Typo="Typo.caption">
                                        @L["WithheldExplanation"]
                                    </MudText>
                                </MudAlert>
                            }
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                @foreach (var topic in training.Topics)
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="Color.Primary"
                                             Variant="Variant.Outlined">
                                        @topic
                                    </MudChip>
                                }
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions>
                            @* Only a training's owner may edit or withdraw it — the API enforces
                               that with TrainingOwnerPolicy. This page used to load every training
                               and hide the buttons on the ones belonging to somebody else, which
                               meant the browser had already received them. It now asks for its
                               own, so every row here is editable and there is nothing left to
                               hide. *@
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Href="@($"/trainings/edit/{training.Id}")"
                                           Disabled="@_standing.IsSuspended" />
                            @* Withdrawing replaced deleting here, and deleting is not offered at
                               all: it is still on the API, for the training created by mistake and
                               for erasure on request, but it is no longer the button a trainer
                               reaches for to stop offering a course. See ADR 0050. *@
                            @* A withheld training is offered no lifecycle button at all. Both doors
                               are shut on the aggregate — PublishAsync and Unpublish each refuse it
                               by name (ADR 0052) — so a button here could only ever answer 400.
                               Editing stays: the domain does not refuse it, and a trainer asked to
                               correct what was reported has to be able to. *@
                            @if (IsWithheld(training))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pa-2">
                                    @L["TakenOutOfYourHands"]
                                </MudText>
                            }
                            else if (IsPublished(training))
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.VisibilityOff"
                                               Disabled="@_standing.IsSuspended"
                                               Color="Color.Warning"
                                               OnClick="@(() => OpenUnpublishDialog(training))" />
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Disabled="@_standing.IsSuspended"
                                               Color="Color.Success"
                                               OnClick="@(() => PublishTraining(training.Id))" />
                            }
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        @if (_page.TotalPages > 1)
        {
            <MudStack AlignItems="AlignItems.Center" Class="mt-6">
                <MudPagination Count="@_page.TotalPages"
                               Selected="@_currentPage"
                               SelectedChanged="OnPageSelectedAsync" />
            </MudStack>
        }
    }
</MudContainer>

@code {
    // Read once per page through the shared source, so the layout's banner and these controls never
    // disagree about the same sanction (ADR 0057).
    private TrainerStanding _standing = TrainerStanding.Active;

    private const int StatusForbidden = 403;
    private const int StatusNotFound = 404;

    // The word the API publishes, which is the domain's own (ADR 0050). Compared ordinally: this
    // is a protocol value, never something to fold with the viewer's culture.
    private const string PublishedStatus = "Published";
    private const string WithheldStatus = "Withheld";

    private static bool IsPublished(TrainingHttpResponse training)
        => string.Equals(training.Status, PublishedStatus, StringComparison.Ordinal);

    private static bool IsWithheld(TrainingHttpResponse training)
        => string.Equals(training.Status, WithheldStatus, StringComparison.Ordinal);

    /// <remarks>
    /// A MudBlazor utility class rather than a color of our own. There is no stylesheet in this
    /// project and no <c>MudTheme</c> override — every color on screen comes from the theme — and
    /// the layout carries a dark mode toggle, so a literal would be right in one of the two themes
    /// and wrong in the other. <c>mud-background-gray</c> resolves to
    /// <c>--mud-palette-background-gray</c>, which the theme provider sets per mode; it is the
    /// surface MudBlazor itself uses for a data grid's group rows, which is the same idea — content
    /// that is present but set back.
    /// <para>
    /// Published returns the class it already had, so a training on offer looks exactly as it did.
    /// Color is never the only signal either: the withdrawn card still carries the word
    /// <em>Unpublished</em> in its chip, for a reader who cannot see the difference in tone.
    /// </para>
    /// </remarks>
    private static string CardClass(TrainingHttpResponse training)
        => IsPublished(training) ? "h-100" : "h-100 mud-background-gray";

    private PagedHttpResponseOfTrainingHttpResponse? _page;
    private int _currentPage = 1;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _standing = await StandingSource.GetAsync();
        await LoadTrainings();
        StateHasChanged();
    }

    private async Task OnPageSelectedAsync(int page)
    {
        _currentPage = page;
        await LoadTrainings();
    }

    private async Task LoadTrainings()
    {
        _isLoading = true;
        try
        {
            // The caller's own trainings, chosen by the server from the token. This used to be
            // GetAllAsync() followed by a comparison in the markup, which is not filtering: the
            // rows were already in the browser, and anyone could read them from the network tab.
            // The trainer is no longer read separately either — the page had to know who it was
            // only in order to do that comparison.
            //
            // One page at a time since ADR 0029; the size stays unset so the server's default
            // rules, and the cap is the server's to hold.
            _page = await TrainingClient.GetMineAsync(_currentPage, null);

            // A page can still fall past the end — withdrawing keeps the row, but the list is
            // read again after every action and the server decides how many pages there are.
            if (_currentPage > _page.TotalPages)
            {
                _currentPage = _page.TotalPages;
                _page = await TrainingClient.GetMineAsync(_currentPage, null);
            }
        }
        catch (ApiException<ProblemDetails> ex)
        {
            // One RFC 7807 document rather than a bare array of errors: the messages travel under
            // `errors` or `domainErrors`, and the shared reader speaks both envelopes. See ADR 0004.
            foreach (var message in ProblemDetailsMessages.Read(ex.Result, Common["RequestRejected"]))
            {
                Snackbar.Add(message, Severity.Error);
            }
        }
        catch (ApiException ex)
        {
            // ex.Message here is the generator's own sentence — "The HTTP status code of the
            // response was not expected (503)." It belongs in the console, not on screen.
            Console.Error.WriteLine(ex);
            Snackbar.Add(L["TrainingsLoadFailedRetry"], Severity.Error);
        }
        catch (Exception ex)
        {
            // Whatever this is, it is ours. A NullReferenceException must not become UI copy.
            Console.Error.WriteLine(ex);
            Snackbar.Add(L["TrainingsLoadFailed"], Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenUnpublishDialog(TrainingHttpResponse training)
    {
        var parameters = new DialogParameters<UnpublishTrainingDialog>
        {
            { x => x.TrainingTitle, training.Title }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<UnpublishTrainingDialog>(
            L["UnpublishTrainingTitle"], parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await UnpublishTraining(training.Id);
        }
    }

    private async Task UnpublishTraining(Guid trainingId)
    {
        // Confirmed by a dialog, unlike publishing: withdrawing takes something away from the
        // people the training was on offer to, and that is worth one click of hesitation. Putting
        // it back takes nothing away from anybody.
        await RunTransition(
            () => TrainingClient.UnpublishTrainingAsync(trainingId),
            L["TrainingUnpublished"],
            L["TrainingNotUnpublishedRetry"],
            L["TrainingNotUnpublishedWrong"]);
    }

    private async Task PublishTraining(Guid trainingId)
        => await RunTransition(
            () => TrainingClient.PublishTrainingAsync(trainingId),
            L["TrainingPublished"],
            L["TrainingNotPublishedRetry"],
            L["TrainingNotPublishedWrong"]);

    /// <remarks>
    /// One error-handling body for both transitions. They fail the same ways and would otherwise
    /// be two copies of the same six catch blocks — with the two that matter, the 404 and the 403,
    /// free to drift apart. The closing sentences are parameters because they are the only thing
    /// that genuinely differs, and each caller hands them over as whole localized sentences —
    /// a verb slot spliced into a template survives no language but this one.
    /// </remarks>
    private async Task RunTransition(Func<Task> transition, string success, string couldNot, string wentWrong)
    {
        try
        {
            await transition();
            Snackbar.Add(success, Severity.Success);
            await LoadTrainings();
        }
        catch (ApiException<ProblemDetails> ex) when (ex.StatusCode == StatusNotFound)
        {
            // Someone deleted it between this page being read and the button being pressed.
            // Not an error the user caused, and the list is simply stale.
            Snackbar.Add(L["TrainingGone"], Severity.Info);
            await LoadTrainings();
        }
        catch (ApiException<ProblemDetails> ex)
        {
            // One RFC 7807 document rather than a bare array of errors: the messages travel under
            // `errors` or `domainErrors`, and the shared reader speaks both envelopes. See ADR 0004.
            // A 409 lands here too: the training was already in the state being asked for, and the
            // server's sentences say so better than anything this page could invent. Reloading
            // afterwards is what makes the buttons agree with the truth again.
            foreach (var message in ProblemDetailsMessages.Read(ex.Result, Common["RequestRejected"]))
            {
                Snackbar.Add(message, Severity.Error);
            }

            await LoadTrainings();
        }
        catch (ApiException ex) when (ex.StatusCode == StatusForbidden)
        {
            // Two refusals wear this status now, and the commonest is the caller's own standing
            // (ADR 0053). A 403 carries no body by design, so which one it is cannot be read out of
            // the response — it is read back from the surface the sanction leaves open, which also
            // raises the banner. Ownership moving under a list read some time ago is the other, and
            // still the one worth naming when the caller is in good standing.
            var standing = await StandingSource.RefreshAsync();
            _standing = standing;

            Snackbar.Add(
                standing.IsSuspended
                    ? Common["SuspendedCannotChange"].Value
                    : L["TrainingBelongsToAnother"].Value,
                Severity.Error);

            await LoadTrainings();
        }
        catch (ApiException ex)
        {
            Console.Error.WriteLine(ex);
            Snackbar.Add(couldNot, Severity.Error);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            Snackbar.Add(wentWrong, Severity.Error);
        }
    }
}
