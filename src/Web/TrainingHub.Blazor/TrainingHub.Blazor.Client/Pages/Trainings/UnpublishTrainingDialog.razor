@using MudBlazor
@inject IStringLocalizer<TrainingResources> L
@inject IStringLocalizer<CommonResources> Common

<MudDialog>
    <DialogContent>
        @* The question is split around the emphasized title rather than templated, because the
           title is markup; the halves carry their own quotation marks so each language quotes the
           way it quotes. *@
        <MudText>
            @L["WithdrawTitleStart"]<strong>@TrainingTitle</strong>@L["WithdrawTitleEnd"]
        </MudText>
        @* The copy replaced "this action cannot be undone", which was true of the deletion this
           dialog used to confirm and is the opposite of what withdrawing means. Saying so is the
           point: a trainer who hesitated over an irreversible button should not hesitate over
           this one. See ADR 0050. *@
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
            @L["WithdrawExplanation"]
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">@Common["Cancel"]</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="Confirm">@L["Unpublish"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string TrainingTitle { get; set; } = string.Empty;

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
}
