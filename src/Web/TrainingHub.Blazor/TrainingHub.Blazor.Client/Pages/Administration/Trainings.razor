@page "/administration/trainings"
@attribute [Authorize(Roles = SessionRoles.Administrator)]
@using TrainingHub.Blazor.Client.Infrastructure
@using TrainingHub.GeneratedClients
@inject IAdministrationClient AdministrationClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<AdministrationResources> L
@inject IStringLocalizer<CommonResources> Common

<MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
    <MudText Typo="Typo.h4" Class="mb-4">@L["Trainings"]</MudText>

    <MudPaper Elevation="0" Class="pa-4 mb-4">
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
            @* Two filters, like the trainers' screen. This one had a state and no term until the
               title stopped being a value-converted column EF Core could not look inside
               (ADR 0060). *@
            <MudSelect T="string"
                       Label="@L["State"]"
                       Value="@_status"
                       ValueChanged="OnStatusChangedAsync"
                       Clearable="true"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Style="max-width: 16rem;">
                <MudSelectItem T="string" Value="@PublishedStatus">@L["PublishedFilter"]</MudSelectItem>
                <MudSelectItem T="string" Value="@UnpublishedStatus">@L["UnpublishedFilter"]</MudSelectItem>
                <MudSelectItem T="string" Value="@WithheldStatus">@L["WithheldFilter"]</MudSelectItem>
            </MudSelect>

            <MudTextField T="string"
                          Label="@L["SearchLabel"]"
                          Value="@_search"
                          ValueChanged="OnSearchChangedAsync"
                          DebounceInterval="400"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          MaxLength="SearchMaxLength"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          HelperText="@L["SearchTrainingsHelper"]" />
        </MudStack>
    </MudPaper>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="my-8">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        </MudStack>
    }
    else if (_page is null || _page.Items.Count == 0)
    {
        <MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size: 6rem;" Class="mb-4" />
            <MudText Typo="Typo.h6">@L["NoTrainingMatches"]</MudText>
        </MudPaper>
    }
    else
    {
        <MudTable Items="@_page.Items" Hover="true" Elevation="1" T="AdministrationTrainingHttpResponse">
            <HeaderContent>
                <MudTh>@L["TitleHeader"]</MudTh>
                <MudTh>@L["OwnerHeader"]</MudTh>
                <MudTh>@L["State"]</MudTh>
                <MudTh>@L["ReasonHeader"]</MudTh>
                <MudTh />
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["TitleHeader"]">@context.Title</MudTd>
                <MudTd DataLabel="@L["OwnerHeader"]">
                    @* The name, not the identifier. An owner whose account is gone leaves this
                       blank rather than dropping the row: a moderator has to see a training whose
                       owner has since left, and what is missing is the name, not the training. *@
                    @if (string.IsNullOrWhiteSpace(context.TrainerName))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <em>@L["NoLongerATrainer"]</em>
                        </MudText>
                    }
                    else
                    {
                        @context.TrainerName
                    }
                </MudTd>
                <MudTd DataLabel="@L["State"]">
                    @if (IsWithheld(context))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                            @L["WithheldBadge"]
                        </MudChip>
                    }
                    else if (!IsPublished(context))
                    {
                        @* Withdrawn by its owner, which is a different thing from taken from them
                           (ADR 0052) — so it is shown differently rather than merged into one
                           "not on offer" badge. *@
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                            @L["UnpublishedBadge"]
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="@L["ReasonHeader"]">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@context.WithholdingReason</MudText>
                </MudTd>
                <MudTd>
                    @if (IsWithheld(context))
                    {
                        <MudButton Size="Size.Small"
                                   Color="Color.Success"
                                   Variant="Variant.Text"
                                   OnClick="@(() => Release(context))">
                            @L["Release"]
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small"
                                   Color="Color.Error"
                                   Variant="Variant.Text"
                                   OnClick="@(() => Withhold(context))">
                            @L["Withhold"]
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>

        @if (_page.TotalPages > 1)
        {
            <MudStack AlignItems="AlignItems.Center" Class="mt-6">
                <MudPagination Count="@_page.TotalPages"
                               Selected="@_currentPage"
                               SelectedChanged="OnPageSelectedAsync" />
            </MudStack>
        }
    }
</MudContainer>

@code {
    // The three words the domain publishes (ADR 0052), compared ordinally.
    private const string PublishedStatus = "Published";
    private const string UnpublishedStatus = "Unpublished";
    private const string WithheldStatus = "Withheld";

    // The bound the contract publishes. Typing past it would be answered 400 by the server, so the
    // field refuses it here instead — the same reading the trainers' screen gives.
    private const int SearchMaxLength = 100;

    private PagedHttpResponseOfAdministrationTrainingHttpResponse? _page;
    private string? _status;
    private string? _search;
    private int _currentPage = 1;
    private bool _isLoading = true;

    private static bool IsWithheld(AdministrationTrainingHttpResponse training)
        => string.Equals(training.Status, WithheldStatus, StringComparison.Ordinal);

    private static bool IsPublished(AdministrationTrainingHttpResponse training)
        => string.Equals(training.Status, PublishedStatus, StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private async Task OnStatusChangedAsync(string? status)
    {
        _status = status;
        _currentPage = 1;
        await LoadAsync();
    }

    private async Task OnSearchChangedAsync(string? search)
    {
        _search = search;
        _currentPage = 1;
        await LoadAsync();
    }

    private async Task OnPageSelectedAsync(int page)
    {
        _currentPage = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _page = await AdministrationClient.GetTrainingsAsync(_status, _search, _currentPage, null);

            if (_currentPage > _page.TotalPages)
            {
                _currentPage = _page.TotalPages;
                _page = await AdministrationClient.GetTrainingsAsync(_status, _search, _currentPage, null);
            }
        }
        catch (Exception exception)
        {
            AdministrationFailures.Report(
                Snackbar,
                exception,
                Common["RequestRejected"],
                L["TrainingsLoadFailedRetry"],
                L["TrainingsLoadFailed"]);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task Withhold(AdministrationTrainingHttpResponse training)
    {
        var reason = await ReasonDialogs.AskAsync(
            DialogService,
            title: L["WithholdTrainingTitle"],
            prompt: L["Withhold"],
            subject: training.Title,
            consequence: L["WithholdConsequence"],
            verb: L["Withhold"]);

        if (reason is null)
        {
            return;
        }

        await RunAsync(
            () => AdministrationClient.WithholdTrainingAsync(
                training.Id, new WithholdTrainingHttpRequest { Reason = reason }),
            success: L["TrainingWithheld"],
            couldNot: L["TrainingNotWithheldRetry"],
            wentWrong: L["TrainingNotWithheldWrong"]);
    }

    private async Task Release(AdministrationTrainingHttpResponse training) =>
        // No dialog: lifting an interdiction takes nothing away from anybody. The training lands on
        // Unpublished rather than back on offer — putting it in the window again is its owner's
        // call, not the administration's (ADR 0052).
        await RunAsync(
            () => AdministrationClient.ReleaseTrainingAsync(training.Id),
            success: L["InterdictionLifted"],
            couldNot: L["TrainingNotReleasedRetry"],
            wentWrong: L["TrainingNotReleasedWrong"]);

    private async Task RunAsync(Func<Task> action, string success, string couldNot, string wentWrong)
    {
        var outcome = await AdministrationFailures.RunAsync(Snackbar, action, new AdministrationCopy(
            success,
            Gone: L["TrainingGone"],
            Rejected: Common["RequestRejected"],
            NoLongerAllowed: Common["NoLongerAllowed"],
            couldNot,
            wentWrong));

        if (outcome is not AdministrationOutcome.Unreachable)
        {
            await LoadAsync();
        }
    }
}
