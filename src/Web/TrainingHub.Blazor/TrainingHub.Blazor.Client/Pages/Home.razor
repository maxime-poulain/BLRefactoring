@page "/"

<PageTitle>TrainingHub</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudText Typo="Typo.h3" GutterBottom="true">TrainingHub</MudText>

    <MudText Typo="Typo.subtitle1" Class="mb-8">
        Trainers publish trainings. This front end talks to the REST API that carries the
        domain model behind it.
    </MudText>

    <AuthorizeView>
        <Authorized>
            <MudPaper Elevation="2" Class="pa-6">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    Signed in as @context.User.Identity?.Name
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-4">
                    Review your trainings, publish a new one, or edit one you already offer.
                </MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="/trainings"
                               StartIcon="@Icons.Material.Filled.School">
                        Go to trainings
                    </MudButton>
                    @* A trainer is a visitor too: the catalog shows them their own trainings the
                       way everyone else sees them (ADR 0062). *@
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Href="/catalog"
                               StartIcon="@Icons.Material.Filled.Storefront">
                        Browse the catalog
                    </MudButton>
                </MudStack>
            </MudPaper>
        </Authorized>
        <NotAuthorized>
            @* This panel used to say that everything past this page required an account, which
               stopped being true the day the catalog got a face (ADR 0062). What an account is
               for is publishing, not looking. *@
            <MudPaper Elevation="2" Class="pa-6 mb-4">
                <MudText Typo="Typo.h6" GutterBottom="true">Browse the catalog</MudText>
                <MudText Typo="Typo.body2" Class="mb-4">
                    Every training currently on offer, searchable by title. No account needed.
                </MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="/catalog"
                           StartIcon="@Icons.Material.Filled.School">
                    Browse trainings
                </MudButton>
            </MudPaper>
            <MudPaper Elevation="2" Class="pa-6">
                <MudText Typo="Typo.h6" GutterBottom="true">Sign in to publish</MudText>
                <MudText Typo="Typo.body2" Class="mb-4">
                    An account is what lets you offer a training of your own: a trainer sees and
                    manages only their own trainings, and a training can only be edited by the
                    trainer who published it.
                </MudText>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login">
                        Sign in
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/register">
                        Create an account
                    </MudButton>
                </MudStack>
            </MudPaper>
        </NotAuthorized>
    </AuthorizeView>
</MudContainer>
