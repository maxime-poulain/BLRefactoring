@using MudBlazor
@inject IStringLocalizer<TrainerResources> L
@inject IStringLocalizer<CommonResources> Common

<MudDialog>
    <DialogContent>
        @* Split around the emphasis rather than templated, because the emphasis is markup. *@
        <MudText>
            @L["EraseIntroStart"]
            <strong>@L["EraseIntroEmphasis"]</strong>@L["EraseIntroEnd"]
        </MudText>
        @* The password is the proof of intent, not decoration: a session outlives an unlocked
           device by up to sixty minutes, and this is the one action nobody can undo afterwards.
           The API checks it (ADR 0085); this field is only how it gets there. *@
        <MudForm @ref="_form" @bind-IsValid="_isValid" OnEnterPressed="Confirm" Class="mt-4">
            <MudTextField @bind-Value="_password"
                          Label="@L["CurrentPassword"]"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="@L["PasswordRequired"]"
                          Immediate="true"
                          HelperText="@L["ErasePasswordHelper"]" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">@Common["Cancel"]</MudButton>
        <MudButton Color="Color.Error"
                   Variant="Variant.Filled"
                   Disabled="@(!_isValid)"
                   OnClick="Confirm">
            @L["EraseAccount"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm _form = null!;
    private bool _isValid;
    private string _password = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private void Cancel() => MudDialog.Cancel();

    private async Task Confirm()
    {
        // Validated once more here and not only through the disabled button: the button's state
        // follows the form's, and a form that has never been touched has never been validated.
        await _form.ValidateAsync();

        if (_isValid)
        {
            MudDialog.Close(DialogResult.Ok(_password));
        }
    }
}
