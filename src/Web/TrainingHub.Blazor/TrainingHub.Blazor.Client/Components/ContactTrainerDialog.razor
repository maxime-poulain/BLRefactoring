@using System.Net.Http.Json
@using MudBlazor
@using TrainingHub.Blazor.Client.Infrastructure
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory

<MudDialog>
    <DialogContent>
        @* Who receives this is said before anything is asked. The form exists so a visitor can
           reach the trainer without being shown an address (ADR 0082), and the counterpart of
           withholding the address is naming the person: a message composed toward nobody in
           particular is the one thing this dialog must never collect. *@
        <MudText>
            Your message goes to <strong>@TrainerName</strong>. They can answer you at the
            address you leave here.
        </MudText>
        <MudForm @ref="_form" @bind-IsValid="_isValid" Class="mt-4">
            <MudTextField @bind-Value="_firstname"
                          Label="First name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="A first name is required"
                          Validation="@(new Func<string, string?>(ValidateFirstname))"
                          Immediate="true"
                          MaxLength="NameMaxLength" />
            <MudTextField @bind-Value="_lastname"
                          Label="Last name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="A last name is required"
                          Validation="@(new Func<string, string?>(ValidateLastname))"
                          Immediate="true"
                          MaxLength="NameMaxLength" />
            <MudTextField @bind-Value="_email"
                          Label="Email address"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Required="true"
                          RequiredError="An email address is required"
                          Validation="@(new Func<string, string?>(ValidateEmail))"
                          Immediate="true"
                          MaxLength="EmailMaxLength"
                          HelperText="@($"{TrainerName} answers you here; the address goes to nobody else.")" />
            <MudTextField @bind-Value="_message"
                          Label="Message"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="A message is required"
                          Validation="@(new Func<string, string?>(ValidateMessage))"
                          Immediate="true"
                          Lines="5"
                          Counter="MessageMaxLength"
                          MaxLength="MessageMaxLength" />
        </MudForm>
        @* The honeypot, named for something plausible because a field called Honeypot teaches a
           bot to skip it (ADR 0082). Off-screen rather than display:none — some scripts skip what
           is not rendered — out of the tab order, and invisible to a screen reader, so no person
           ever reaches it and a form-filling script does. *@
        <input name="website"
               type="text"
               autocomplete="url"
               tabindex="-1"
               aria-hidden="true"
               style="position: absolute; left: -9999px; height: 1px; width: 1px; overflow: hidden;"
               @bind="_website" @bind:event="oninput" />
        @* The Turnstile widget, rendered into this element by explicit interop once the dialog is
           on screen: the loader script scanned the page long before this dialog existed, so
           implicit rendering cannot find it (ADR 0083). For most visitors it decides invisibly. *@
        <div @ref="_turnstileHost" class="mt-4"></div>
        @if (_turnstileMissing)
        {
            <MudText Color="Color.Error" Typo="Typo.caption">
                Complete the check above to send your message.
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(!_isValid)"
                   OnClick="Confirm">
            Send
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // The bounds ContactTrainerHttpRequest publishes, and nothing tighter: a dialog that refused
    // what the server accepts is the one direction of that mistake nobody reports, because it
    // never produces an error to read. Presence and length only, as on the contract itself —
    // whether the address is shaped like one is the domain's judgment, not this form's (ADR 0043).
    private const int NameMaxLength = 100;
    private const int EmailMaxLength = 320;
    private const int MessageMaxLength = 2000;
    private const int MessageMinLength = 10;

    private MudForm _form = null!;
    private bool _isValid;
    private string _firstname = string.Empty;
    private string _lastname = string.Empty;
    private string _email = string.Empty;
    private string _message = string.Empty;
    private string? _website;
    private ElementReference _turnstileHost;
    private string? _widgetId;
    private bool _turnstileMissing;
    private bool _challengeDisabled;

    /// <summary>The person the message goes to, named so the visitor is never in doubt.</summary>
    [Parameter]
    public string TrainerName { get; set; } = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private static string? ValidateFirstname(string value) =>
        ValidateName(value, "A first name is required");

    private static string? ValidateLastname(string value) =>
        ValidateName(value, "A last name is required");

    private static string? ValidateName(string value, string absent)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return absent;
        }

        return value.Trim().Length > NameMaxLength
            ? $"A name cannot exceed {NameMaxLength} characters"
            : null;
    }

    private static string? ValidateEmail(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "An email address is required";
        }

        return value.Trim().Length > EmailMaxLength
            ? $"An email address cannot exceed {EmailMaxLength} characters"
            : null;
    }

    /// <remarks>
    /// The floor is checked on the trimmed text because the trimmed text is what is sent: ten
    /// spaces satisfy the raw bound and would still arrive as an empty message, which is a click
    /// rather than a contact.
    /// </remarks>
    private static string? ValidateMessage(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "A message is required";
        }

        var written = value.Trim();

        if (written.Length < MessageMinLength)
        {
            return $"A message needs at least {MessageMinLength} characters";
        }

        return written.Length > MessageMaxLength
            ? $"A message cannot exceed {MessageMaxLength} characters"
            : null;
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>
    /// Renders the Turnstile widget into its element, once the dialog is on screen.
    /// </summary>
    /// <remarks>
    /// The site key is asked of the BFF here rather than configured, because the WebAssembly
    /// application carries no configuration of its own (ADR 0035). A null key means the challenge
    /// is off — no pair was configured server-side — and the dialog simply renders no widget and
    /// asks for no token (ADR 0083). A widget that cannot come up while the challenge is on — the
    /// loader still on the wire, the key endpoint unreachable — leaves <c>_widgetId</c> empty,
    /// and the send button then refuses with the same message an unsolved check gets: the BFF
    /// would answer 403 anyway, so the dialog stays usable to cancel, and reopening it tries
    /// again.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var settings = await HttpClientFactory
                .CreateClient(HttpClientNames.Bff)
                .GetFromJsonAsync<TurnstileSettings>(BffContract.TurnstileEndpoint);

            if (string.IsNullOrEmpty(settings?.SiteKey))
            {
                _challengeDisabled = true;
                return;
            }

            _widgetId = await JS.InvokeAsync<string>(
                "turnstile.render",
                _turnstileHost,
                new { sitekey = settings.SiteKey, theme = "auto" });
        }
        catch (HttpRequestException)
        {
            // The refusal happens at Confirm, worded for the visitor.
        }
        catch (JSException)
        {
            // Same: no widget means no token, and Confirm says so.
        }
    }

    private async Task Confirm()
    {
        // Validated once more here and not only through the disabled button: the button's state
        // follows the form's, and a form that has never been touched has never been validated.
        await _form.ValidateAsync();

        if (!_isValid)
        {
            return;
        }

        // Asked of the widget at the moment of sending, because that is when it must exist: the
        // token is minted when the check completes — invisibly, for most visitors — and an empty
        // answer means the check is not done, or never came up (ADR 0083). With the challenge off
        // there is no widget and no token to ask for, and the draft honestly carries none.
        var token = _widgetId is null
            ? null
            : await JS.InvokeAsync<string?>("turnstile.getResponse", _widgetId);

        if (!_challengeDisabled && string.IsNullOrEmpty(token))
        {
            _turnstileMissing = true;
            return;
        }

        MudDialog.Close(DialogResult.Ok(new ContactDraft(
            _firstname.Trim(),
            _lastname.Trim(),
            _email.Trim(),
            _message.Trim(),
            string.IsNullOrEmpty(_website) ? null : _website,
            string.IsNullOrEmpty(token) ? null : token)));
    }

    /// <summary>
    /// Removes the widget with the dialog, so a reopened dialog renders a fresh one.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (_widgetId is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("turnstile.remove", _widgetId);
        }
        catch (JSException)
        {
            // The page is going away with the widget; there is nothing left to clean.
        }
    }
}
