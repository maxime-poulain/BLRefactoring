@using TrainingHub.Blazor.Client.Infrastructure
@implements IDisposable
@inject ITrainerStandingSource StandingSource
@inject IStringLocalizer<CommonResources> L

@if (_standing.IsSuspended)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" NoIcon="false">
        <MudText Typo="Typo.subtitle2">@L["AccountSuspended"]</MudText>
        @* The administrator's words, shown as written — and in the language they were written in.
           Two texts describing one sanction is how a product ends up arguing with itself
           (ADR 0057), and a translated sanction would be this product paraphrasing an
           administrator. *@
        <MudText Typo="Typo.body2" Class="mt-1">@_standing.Reason</MudText>
        <MudText Typo="Typo.body2" Class="mt-2">
            @L["AccountSuspendedBody"]
        </MudText>
    </MudAlert>
}

@code {
    private TrainerStanding _standing = TrainerStanding.Active;

    protected override async Task OnInitializedAsync()
    {
        StandingSource.Changed += OnChanged;
        _standing = await StandingSource.GetAsync();
    }

    private async void OnChanged()
    {
        _standing = await StandingSource.GetAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => StandingSource.Changed -= OnChanged;
}
