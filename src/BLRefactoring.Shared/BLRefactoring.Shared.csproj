<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    Ardalis.SmartEnum backs ErrorCode; Mediator.Abstractions backs IDomainEvent and the CQS
    marker interfaces. Nothing else: EmailValidation moved to the domain project, next to the
    Email value object that actually calls it, and neither Microsoft.Extensions.Logging nor
    DependencyInjection was ever referenced from a single file here.
  -->
  <ItemGroup>
    <PackageReference Include="Ardalis.SmartEnum" />
    <PackageReference Include="Mediator.Abstractions" />
  </ItemGroup>

</Project>
