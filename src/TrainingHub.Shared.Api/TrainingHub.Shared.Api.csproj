<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <!--
      Everything an API host needs and that both of them would otherwise copy: the controller
      bases, the authorization policy, the CORS and identity wiring, the HTTP side of optimistic
      concurrency. It exists so that TrainingHub.Shared.Infrastructure can go back to being
      about persistence alone — it used to carry MVC and authentication for the sole benefit of
      AuthControllerBase, and a policy declared in one host's Program.cs only protects that host.
    -->
    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <!-- For ValidationExceptionHandler alone: the API has to recognise a validation failure to
           answer it as a ValidationProblemDetails. No validator is declared here — the rules stay
           in the application layer, only their translation to HTTP lives at this boundary. -->
      <PackageReference Include="FluentValidation" />
      <!-- The OpenAPI document and its reference UI are configured here, in OpenApiExtensions,
           so both hosts describe the API the same way. -->
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
      <PackageReference Include="Scalar.AspNetCore" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
      <!-- Referenced explicitly rather than through the JwtBearer package: TokenService writes
           tokens with JwtSecurityTokenHandler, which is a different concern from validating them. -->
      <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
      <!-- The logging pipeline both hosts share: LoggingExtensions configures the sinks, and
           ApiLoggingOptions is the whole surface a deployment tunes. See ADR 0026. -->
      <PackageReference Include="Serilog.AspNetCore" />
    </ItemGroup>

    <!--
      The application layer is referenced so the HTTP contracts can be mapped to and from it in
      one place. The dependency runs the way the layering requires — the API knows the application
      layer, never the reverse — and it now stops at Contracts/Mappings instead of running through
      every controller signature.
    -->
    <ItemGroup>
      <ProjectReference Include="..\TrainingHub.Shared.Application\TrainingHub.Shared.Application.csproj" />
      <ProjectReference Include="..\TrainingHub.Shared.Infrastructure\TrainingHub.Shared.Infrastructure.csproj" />
    </ItemGroup>

</Project>
