<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Writes this host's OpenAPI document to disk during the build, so the client generator has a
      file to read and never has to start a server or load this assembly itself. That indirection
      is what rotted the previous setup: its configuration pinned an assembly path and a runtime
      moniker, both of which go stale on every target-framework change.

      NSwag itself is not referenced here. The client is generated by the NSwag CLI, pinned in
      .config/dotnet-tools.json and invoked by scripts/generate-clients.sh — never by this build.
      See ADR 0008.
    -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <!--
      Off by default, and that is the point of choosing a CLI over an MSBuild target: an ordinary
      `dotnet build` generates nothing and costs nothing. Emitting the document loads this host —
      everything before app.Run() executes — so making it unconditional would mean every build of
      this project touches a database.

      scripts/generate-clients.sh turns it on with -p:OpenApiGenerateDocuments=true, and only then.
      The document lands next to the project as TrainingHub.DDD.Api.json, the default name, which
      is what generator.nswag reads.
    -->
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TrainingHub.Shared.Api\TrainingHub.Shared.Api.csproj" />
    <ProjectReference Include="..\Infrastructure\TrainingHub.DDD.Infrastructure.csproj" />
  </ItemGroup>

</Project>
