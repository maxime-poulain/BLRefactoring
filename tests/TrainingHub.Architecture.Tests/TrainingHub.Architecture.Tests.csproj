<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The rules this repository states in prose, as tests.

      The name deliberately carries no "IntegrationTests": both workflow filters key on a test's
      fully-qualified name, which begins at the root namespace, and this suite belongs to the fast
      one. SuiteSelfRules asserts that rather than trusting it — this project references the two
      integration suites, so it names types whose namespaces do contain the substring.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <!--
      Half these rules read files rather than assemblies: the csproj graph, the records under
      docs/adr, the namespace of every source file. A test runs from bin/Release/net10.0, so the
      repository root is stamped in at build time rather than walked for at run time. A root guessed
      wrong would make every file scan run over an empty set — which is the one failure mode a green
      suite cannot show you, and the reason SourceTree refuses to hand out a root that holds no
      solution file.
    -->
    <ItemGroup>
        <AssemblyMetadata Include="RepositoryRoot"
                          Value="$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../../'))" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector" />
        <PackageReference Include="NetArchTest.eNhancedEdition" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <!--
      The HTTP boundary rules name ControllerBase, ProblemDetails and the MVC application model.
      Those arrive transitively through TrainingHub.Shared.Api, which declares the same line;
      stating it here means a rule stops compiling if that ever changes, rather than resolving
      through a path nobody chose.
    -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!--
      The backend graph, in full. The three routing projects — DDD.Domain, DDD.Infrastructure and
      DDDWithCqrs.Domain — are absent on purpose: they hold no source file, so there is no type to
      resolve them by. Their edges are checked from the csproj graph, which needs no reference.

      The kit and the two integration suites are here for one rule: every shared test base is run by
      both hosts. The alternative would be grepping the suites for ": AuthTest<ApiFactory>", which
      trades a compiler for a regular expression.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\TrainingHub.Shared\TrainingHub.Shared.csproj" />
        <ProjectReference Include="..\..\src\TrainingHub.Shared.Domain\TrainingHub.Shared.Domain.csproj" />
        <ProjectReference Include="..\..\src\TrainingHub.Shared.Application\TrainingHub.Shared.Application.csproj" />
        <ProjectReference Include="..\..\src\TrainingHub.Shared.Infrastructure\TrainingHub.Shared.Infrastructure.csproj" />
        <ProjectReference Include="..\..\src\TrainingHub.Shared.Api\TrainingHub.Shared.Api.csproj" />
        <ProjectReference Include="..\..\src\DDD\Application\TrainingHub.DDD.Application.csproj" />
        <ProjectReference Include="..\..\src\DDD\Api\TrainingHub.DDD.Api.csproj" />
        <ProjectReference Include="..\..\src\DDDWithCqrs\Application\TrainingHub.DDDWithCqrs.Application.csproj" />
        <ProjectReference Include="..\..\src\DDDWithCqrs\Infrastructure\TrainingHub.DDDWithCqrs.Infrastructure.csproj" />
        <ProjectReference Include="..\..\src\DDDWithCqrs\Api\TrainingHub.DDDWithCqrs.Api.csproj" />
        <ProjectReference Include="..\TrainingHub.Api.TestKit\TrainingHub.Api.TestKit.csproj" />
        <ProjectReference Include="..\TrainingHub.DDD.Api.IntegrationTests\TrainingHub.DDD.Api.IntegrationTests.csproj" />
        <ProjectReference Include="..\TrainingHub.DDDWithCqrs.Api.IntegrationTests\TrainingHub.DDDWithCqrs.Api.IntegrationTests.csproj" />
    </ItemGroup>

    <!--
      The remaining six test projects, for one rule and one rule only: "no type inherits this class".
      That statement cannot be made from a partial view of the solution. A production class whose
      only subclass is a test double is inherited, and demanding a `sealed` it cannot carry would be
      a rule that is confidently wrong. So the project that says it has to see everything — which,
      for a suite whose job is the shape of the whole solution, is the right shape to be in.
    -->
    <ItemGroup>
        <ProjectReference Include="..\TrainingHub.Shared.Domain.Tests\TrainingHub.Shared.Domain.Tests.csproj" />
        <ProjectReference Include="..\TrainingHub.Shared.Api.Tests\TrainingHub.Shared.Api.Tests.csproj" />
        <ProjectReference Include="..\TrainingHub.Shared.Infrastructure.Tests\TrainingHub.Shared.Infrastructure.Tests.csproj" />
        <ProjectReference Include="..\TrainingHub.DDD.Application.Tests\TrainingHub.DDD.Application.Tests.csproj" />
        <ProjectReference Include="..\TrainingHub.DDDWithCqrs.Tests\TrainingHub.DDDWithCqrs.Tests.csproj" />
        <ProjectReference Include="..\TrainingHub.Blazor.Bff.Tests\TrainingHub.Blazor.Bff.Tests.csproj" />
    </ItemGroup>

</Project>
