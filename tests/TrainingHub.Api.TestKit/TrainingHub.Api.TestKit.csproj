<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test infrastructure shared by the integration suites of both API stacks. It holds no
    tests of its own, and the name stays clear of "IntegrationTests" so neither CI filter
    tries to select it.

    IsTestProject must be false rather than merely absent. Left unset, `dotnet test` on the
    solution still runs VSTest against this assembly; its test host then fails to start
    because a class library's deps.json lists transitive package assemblies that were never
    copied beside it, and the whole run aborts — with both real suites passing, which makes
    the failure read like anything but this.
  -->
  <!--
    SonarQubeTestProject undoes, for the analyzer alone, what IsTestProject had to say to MSBuild.
    The scanner for .NET reads IsTestProject to decide what a project holds, so declaring it false
    made this one production code: its files were measured for coverage on new code, and a shared
    fact added here counted against the gate as though it shipped in a host. Nothing here ships
    anywhere — the assembly is referenced by the two integration suites and by nothing else.
    Telling the analyzer what the project is corrects a misclassification; it does not silence a
    finding, and the code is still analyzed for issues.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>false</IsTestProject>
    <SonarQubeTestProject>true</SonarQubeTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Respawn" />
    <!--
      The container core, for the object store. SeaweedFS has no Testcontainers module of its own,
      so the builder is used directly rather than through one.
    -->
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TrainingHub.Shared.Api\TrainingHub.Shared.Api.csproj" />
  </ItemGroup>

</Project>
