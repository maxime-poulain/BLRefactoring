# IDE0051: Remove unused private members
# In force. It is wrong about exactly one construct — the private constructor every EntityId<T>
# subclass declares, which `EntityId<T>.BuildFactory` reaches through GetConstructor(..., NonPublic)
# and a compiled expression tree — and that is said at each of those five sites with an attribute
# carrying the reason, rather than here by turning the rule off for the whole repository.
dotnet_diagnostic.IDE0051.severity = warning

# IDE0055: All formatting rules
# The single most consequential line in this file, and it had been a suggestion with no reason
# written beside it. Every formatting decision above — Allman braces, the newline settings, System
# directives sorted first, four-space indentation — is reported through IDE0055 and through nothing
# else. While this said `suggestion`, all of them were preferences an editor might apply and a build
# would not check. Measured before promoting: seven occurrences in the whole solution.
dotnet_diagnostic.IDE0055.severity = warning

# IDE0059: Unnecessary assignment to a value
dotnet_diagnostic.IDE0059.severity = warning

