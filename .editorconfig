# IDE0036: Order modifiers
# No `:suggestion` on the preference. The trailing form is the older way of writing a severity, and
# where both forms appear the `dotnet_diagnostic` line below wins — so the suffix said "suggestion"
# about a rule that was an error, to every reader of this file and to no compiler.
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async
dotnet_diagnostic.IDE0036.severity = warning

# IDE0038: Use pattern matching to avoid is check followed by a cast (without variable)
dotnet_diagnostic.IDE0038.severity = warning

