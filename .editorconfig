# ---------------------------------------------------------------------------------------------
# Rules this file had never named, and what each of them costs.
#
# The list above is a curated forty-nine CA rules and twenty-four IDE ones. Nothing recorded where
# the curation came from or what was left out, and the answer turned out to be: almost everything.
# The .NET analyzers ship roughly four hundred and fifty CA rules and a hundred IDE ones.
#
# A census measured them, because guessing is what left this file unenforced for a whole record
# (ADR 0017, then ADR 0019). Every rule below carries the number it produced when it was switched
# on against this tree. See ADR 0020.
# ---------------------------------------------------------------------------------------------

# --- Free. Sixty rules, and every one of them reported zero occurrences. -----------------------
#
# The reason this block is worth having is not the rules it turns on today — it is that the tree
# already satisfied all sixty and nothing was holding it there. A rule this codebase obeys by habit
# is a rule the next commit may break in silence; declared, it cannot.
#
# Four of them make an existing preference real. `dotnet_style_qualification_for_field/property`,
# `dotnet_style_predefined_type_*`, `csharp_style_var_*` and `csharp_style_throw_expression` are
# stated at the top of this file with a trailing `:suggestion`, which is to say they were opinions
# no build acted on. IDE0003/IDE0009, IDE0049, IDE0007 and IDE0016 are the diagnostics that report
# them, and all four cost nothing.
dotnet_diagnostic.IDE0001.severity = warning
dotnet_diagnostic.IDE0002.severity = warning
dotnet_diagnostic.IDE0003.severity = warning
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0009.severity = warning
dotnet_diagnostic.IDE0010.severity = warning
dotnet_diagnostic.IDE0016.severity = warning
dotnet_diagnostic.IDE0017.severity = warning
dotnet_diagnostic.IDE0018.severity = warning
dotnet_diagnostic.IDE0019.severity = warning
dotnet_diagnostic.IDE0025.severity = warning
dotnet_diagnostic.IDE0026.severity = warning
dotnet_diagnostic.IDE0027.severity = warning
dotnet_diagnostic.IDE0033.severity = warning
dotnet_diagnostic.IDE0034.severity = warning
dotnet_diagnostic.IDE0037.severity = warning
dotnet_diagnostic.IDE0042.severity = warning
dotnet_diagnostic.IDE0047.severity = warning
dotnet_diagnostic.IDE0048.severity = warning
dotnet_diagnostic.IDE0049.severity = warning
# IDE0052 is IDE0051's other half: one finds a private member nobody calls, this one finds a
# private member written and never read. The first was declared and the second was not.
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0054.severity = warning
dotnet_diagnostic.IDE0056.severity = warning
dotnet_diagnostic.IDE0057.severity = warning
dotnet_diagnostic.IDE0063.severity = warning
dotnet_diagnostic.IDE0065.severity = warning
dotnet_diagnostic.IDE0066.severity = warning
dotnet_diagnostic.IDE0071.severity = warning
dotnet_diagnostic.IDE0072.severity = warning
dotnet_diagnostic.IDE0074.severity = warning
dotnet_diagnostic.IDE0075.severity = warning
