<Project>

  <!--
    Central Package Management: every NuGet version of the solution lives here.
    Projects reference packages without a Version attribute; adding a package
    means adding (or reusing) a PackageVersion entry below.
    https://learn.microsoft.com/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Community fork of FluentAssertions 7, under Apache 2.0. FluentAssertions 8 moved to a
      commercial Xceed licence; this keeps the same fluent API on a permissive one.
    -->
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
    <!--
      Renders a Blazor component in-process so a test can drive it. Added because the profile page
      is the first component in this repository carrying logic worth proving — a size check
      mirroring the API's, an address built to defeat a year-long cache, and a failure path that
      shows the server's own words.
    -->
    <PackageVersion Include="bunit" Version="2.8.6" />
    <!--
      The S3 client, under Apache 2.0. Named for Amazon, but nothing here talks to Amazon: the
      adapter points it at whatever endpoint the configuration names, which is a SeaweedFS
      container locally. S3 is the protocol every object store on the shortlist speaks, so the
      choice of client is what makes the provider a configuration value rather than a rewrite —
      the server is the replaceable part. See ADR 0021.
    -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.101.6" />
    <!--
      Collects line coverage during `dotnet test`, in OpenCover format, for the analysis to read.
      Referenced by every project that runs tests and by no other — an architecture rule checks
      that, because a test project without it reports no coverage at all rather than failing, and
      the quality gate would read the silence as uncovered code.
    -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="EmailValidation" Version="1.3.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <!--
      The SMTP and MIME client, under MIT. Microsoft documents System.Net.Mail.SmtpClient as
      obsolete for new development and names this library as its replacement. SMTP is to mail what
      S3 is to storage in ADR 0021: the protocol every provider on the shortlist speaks, so the
      choice of client is what makes the mail server a configuration value rather than a rewrite —
      locally it is a Mailpit container, in production whatever relay the deployment names. Only the
      infrastructure references it, and an architecture rule holds that line. See ADR 0031.
    -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!--
      The Blazor hosts and the generated clients target net9.0: the
      Microsoft.AspNetCore.Components family stays on the latest 9.0.x —
      its 10.x line requires net10.0.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.18" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.18" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.18" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <!--
      Writes the API's OpenAPI document to disk during the build, so the client generator reads a
      file instead of loading the host itself. Only the layered API references it, and only
      scripts/generate-clients.sh turns the emission on. See ADR 0008.
    -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10" />
    <!--
      The framework's own OpenAPI document generator, used by both hosts. It replaced NSwag on one
      and Swashbuckle on the other: two libraries describing one API produced two documents that
      disagreed on nullability and enum representation. See ADR 0006.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Pinned, not referenced: Microsoft.AspNetCore.OpenApi 10.0.10 pulls Microsoft.OpenApi 2.0.0,
      which carries GHSA-v5pm-xwqc-g5wc (CVSS 7.5) — a circular schema reference makes the document
      reader recurse until the process dies. First patched version is 2.7.5, and no 10.0.x of the
      ASP.NET Core package ships it yet, so transitive pinning (enabled above) is what closes it.
      Remove this line once the framework package references a patched version itself.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <!--
      Pinned, not referenced — like Microsoft.OpenApi above, and for the same mechanism rather than
      the same reason. No project carries a PackageReference to either of these two; they arrive
      transitively, and transitive pinning (enabled above) is what keeps them on the version the
      rest of the EF and Extensions families are on. Said out loud because a version with no
      visible consumer reads as dead weight, and deleting it would let the graph resolve them
      wherever their dependents happen to point.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="MudBlazor" Version="9.7.0" />
    <!--
      Reads compiled assemblies with Mono.Cecil and states an architectural rule as a fluent
      predicate, for TrainingHub.Architecture.Tests. The eNhanced fork rather than
      NetArchTest.Rules: the original has shipped nothing since May 2021 and still carries
      Mono.Cecil 0.11.3, which predates every metadata change since. This one is maintained, and
      its failures name why a type failed and where it is declared — the difference between a
      failure a reader can act on and a boolean. Mono.Cecil itself arrives transitively and needs
      no entry: transitive pinning applies to packages declared here, not to every package resolved.
    -->
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.16" />
    <!--
      The logging pipeline of the two API hosts: console and rolling text files, from one typed
      options class. The framework's own logging has no file sink at all, and this meta-package is
      the smallest entry that closes the gap — it carries Serilog itself, both sinks, and the
      hosting integration that swaps the logger factory, so this is the only line needed and the
      transitive pinning above keeps the rest coherent. See ADR 0026.
    -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!--
      The reverse proxy the Blazor host uses as a BFF: the browser calls its own origin, and this
      forwards to the API with the access token attached server-side. See ADR 0009.
    -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <!--
      The container core, referenced directly rather than only pulled in by Testcontainers.MsSql
      below: the object store the integration suite runs against is a plain SeaweedFS image with no
      module of its own, so the builder is used by hand. Same version as the MsSql module on
      purpose — they share this assembly, and letting them drift resolves one of the two twice.
    -->
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
